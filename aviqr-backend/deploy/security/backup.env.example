# /etc/aviqr/backup.env (root:aviqr-backup 640). Read by aviqr-backup.service.
BACKUP_DIRECTORY=/var/lib/aviqr/backups
BACKUP_GPG_HOME=/var/lib/aviqr/backup-gpg
# Fingerprint of the backup public key; the private key is kept off the server.
BACKUP_RECIPIENT=<40-hex fingerprint>
# Every database to dump; add new ones here (and GRANT CONNECT to "aviqr-backup").
BACKUP_DATABASES=aviqr_auth aviqr_hotel aviqr_mall aviqr_menu aviqr_order aviqr_payment aviqr_payment_gateway aviqr_pms aviqr_qr aviqr_report aviqr_review aviqr_shop aviqr_support
# mongodump --config file holding the read-only backup user's URI.
MONGO_BACKUP_CONFIG=/var/lib/aviqr/backup-mongo.yaml
# Off-host copy over SFTP (Hetzner Storage Box: port 23, key auth, pinned host key).
BACKUP_SFTP_TARGET=<user>@<user>.your-storagebox.de
BACKUP_SFTP_PORT=23
BACKUP_SFTP_DIR=aviqr-backups
BACKUP_SSH_KEY=/var/lib/aviqr/backup-ssh/id_ed25519
BACKUP_SSH_KNOWN_HOSTS=/var/lib/aviqr/backup-ssh/known_hosts
BACKUP_KEEP_LOCAL=14
BACKUP_KEEP_REMOTE=30
