    <!-- QA/demo data for the Leads admin screen — runs in every environment
         (including production, at the user's request) so the feature has
         something to look at immediately after deploy. Deliberately unmistakable
         as fake: "[Demo]" business-name prefix, and every email uses
         example.com, the domain IANA/RFC 2606 reserves specifically so it can
         never resolve to a real inbox — clicking Send on a demo lead's draft
         will just bounce, not reach an actual business. One lead (Coastal
         Bites Cafe) is seeded 5 days past contact specifically so
         LeadFollowUpScheduler has something to auto-draft on its next run,
         doubling as a live test of Phase 2. -->
    <changeSet id="004-lead-dummy-data" author="aviqr">
        <!-- Only seed into an empty table — guards against duplicate demo rows
             if this changeset is ever re-run or the changelog table is reset. -->
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <rowCount tableName="leads" expectedRows="0"/>
        </preConditions>
