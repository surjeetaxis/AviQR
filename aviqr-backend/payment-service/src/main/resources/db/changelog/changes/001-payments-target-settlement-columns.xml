<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Payment.targetType/settlementId were added to the entity without a migration —
         production runs ddl-auto=none (this service had no Liquibase setup at all until
         now), so every admin Payments page load failed with "column p1_0.settlement_id
         does not exist" (target_type was equally missing, Postgres just reports the first
         one it hits) — confirmed live in production. Local dev never caught this because
         ddl-auto=update silently added them there. -->
    <changeSet id="001-payments-target-type" author="aviqr">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and><tableExists tableName="payments"/><not><columnExists tableName="payments" columnName="target_type"/></not></and>
        </preConditions>
        <addColumn tableName="payments">
            <column name="target_type" type="VARCHAR(20)" defaultValue="ORDER"/>
        </addColumn>
        <sql>ALTER TABLE payments ADD CONSTRAINT payments_target_type_check CHECK (target_type IN ('ORDER','BILL'));</sql>
    </changeSet>

    <changeSet id="001-payments-settlement-id" author="aviqr">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and><tableExists tableName="payments"/><not><columnExists tableName="payments" columnName="settlement_id"/></not></and>
        </preConditions>
        <addColumn tableName="payments">
            <column name="settlement_id" type="UUID"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
