<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Backs the new ROOM_SERVICE QrType — a QR that is linked to both a specific
         room AND a specific outlet's shop at creation time, so scanning it drops
         the guest straight onto that outlet's menu with room context for
         "charge to room" (see QrService.buildUrl/generateUniqueCode). Production
         runs ddl-auto=none, so this column needs an explicit changeset. -->
    <changeSet id="003-qrcodes-room-number" author="aviqr">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <and><tableExists tableName="qr_codes"/><not><columnExists tableName="qr_codes" columnName="room_number"/></not></and>
        </preConditions>
        <addColumn tableName="qr_codes">
            <column name="room_number" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
