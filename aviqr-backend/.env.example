# ═══════════════════════════════════════════════════════════════════════════════
# AviQR Backend — Environment Variables
# Copy to .env and fill in real values before starting
# NEVER commit .env to Git
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core Security ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=aviqr_super_secret_key_change_this_in_production_min_32_chars

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=aviqr
POSTGRES_PASSWORD=aviqr_secret
DB_USERNAME=aviqr
DB_PASSWORD=aviqr_secret

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_USERNAME=aviqr
MONGO_PASSWORD=aviqr_secret

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=aviqr_redis_secret

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=aviqr
RABBITMQ_PASSWORD=aviqr_secret

# ── Razorpay (Payment Gateway) ─────────────────────────────────────────────────
# Get from: https://razorpay.com → Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Twilio (SMS OTP + WhatsApp notifications) ──────────────────────────────────
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true once Twilio is configured and tested
APP_WHATSAPP_ENABLED=false

# ── SMTP Email ─────────────────────────────────────────────────────────────────
# Gmail: use App Password (not your Gmail password)
# Go to: myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@aviqr.in
SMTP_PASSWORD=your_app_password_here

# ── Anthropic AI (all 11 AI features — required for AI Hub) ────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Vision API (OCR menu upload) ────────────────────────────────────────
# Get from: console.cloud.google.com → APIs → Vision API → Credentials
# Leave blank to use intelligent demo fallback
GOOGLE_VISION_API_KEY=

# ── Zomato / Swiggy aggregator (optional) ──────────────────────────────────────
AGGREGATOR_ZOMATO_SECRET=
AGGREGATOR_SWIGGY_TOKEN=

# ── Eureka service registry ────────────────────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ── App URLs ───────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
