# ═══════════════════════════════════════════════════════════════════════════════
# AviQR Backend — Environment Variables
# Copy to .env and fill in real values before starting
# NEVER commit .env to Git
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core Security ──────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=aviqr_super_secret_key_change_this_in_production_min_32_chars

# Shared secret for internal service-to-service calls that bypass user JWT auth
# (order-qr-service payment-sync, notification-report-review-service SMS relay,
# support-service -> auth-service impersonation-token minting).
# Generate: openssl rand -hex 32
INTERNAL_SYNC_SECRET=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=aviqr
POSTGRES_PASSWORD=aviqr_secret
DB_USERNAME=aviqr
DB_PASSWORD=aviqr_secret

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_USERNAME=aviqr
MONGO_PASSWORD=aviqr_secret

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=aviqr_redis_secret

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=aviqr
RABBITMQ_PASSWORD=aviqr_secret

# ── Razorpay (Payment Gateway) ─────────────────────────────────────────────────
# Get from: https://razorpay.com → Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Separate secret from Dashboard → Settings → Webhooks (NOT the API key secret above)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Settlement (nightly auto-settlement job, payment-service) ──────────────────
# Global kill switch; per-shop opt-out lives in shop settings (autoSettlementEnabled)
SETTLEMENT_JOB_ENABLED=true
# Cron: seconds minutes hours day-of-month month day-of-week — default runs at 2 AM daily
SETTLEMENT_CRON=0 0 2 * * *

# ── Twilio (SMS OTP + WhatsApp notifications) ──────────────────────────────────
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Set to true once Twilio is configured and tested
APP_WHATSAPP_ENABLED=false

# ── SMTP Email ─────────────────────────────────────────────────────────────────
# Gmail: use App Password (not your Gmail password)
# Go to: myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@aviqr.in
SMTP_PASSWORD=your_app_password_here

# ── Anthropic AI (all 11 AI features — required for AI Hub) ────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI (fallback AI provider — used if the Anthropic call fails) ───────────
# Get from: platform.openai.com → API Keys
# Leave blank to disable the fallback (AI Hub falls straight to the rule-based
# JS fallback in aiFallback.js instead).
OPENAI_API_KEY=

# ── Google Vision API (OCR menu upload) ────────────────────────────────────────
# Get from: console.cloud.google.com → APIs → Vision API → Credentials
# Leave blank to use intelligent demo fallback
GOOGLE_VISION_API_KEY=

# Preferred over GOOGLE_VISION_API_KEY: path to a GCP service-account JSON key
# (console.cloud.google.com → IAM & Admin → Service Accounts → Keys). Do NOT commit
# the key file — keep it outside the repo and point this at its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=

# ── Zomato / Swiggy aggregator (optional) ──────────────────────────────────────
AGGREGATOR_ZOMATO_SECRET=
AGGREGATOR_SWIGGY_TOKEN=

# ── Support analytics (support-service reads auth/order DBs read-only) ────────
# Only needed if these DBs live on a different host than DB_URL's default
# (localhost:5432/aviqr_auth, aviqr_order) — e.g. separate DB hosts in production.
ANALYTICS_AUTH_DB_URL=
ANALYTICS_AUTH_DB_USERNAME=
ANALYTICS_AUTH_DB_PASSWORD=
ANALYTICS_ORDER_DB_URL=
ANALYTICS_ORDER_DB_USERNAME=
ANALYTICS_ORDER_DB_PASSWORD=

# ── Eureka service registry ────────────────────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ── App URLs ───────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
