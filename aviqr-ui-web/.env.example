# AviQR Web — Environment Variables
# Copy to .env.local for local dev, .env.production for production build

# Backend API URL
VITE_API_URL=http://localhost:8080

# Sentry DSN (optional — crash reporting)
# Get from: sentry.io → New Project → React
VITE_SENTRY_DSN=

# Google Analytics 4 Measurement ID (optional — unset disables GA entirely)
# Get from: analytics.google.com → Admin → Data Streams → your web stream
VITE_GA_MEASUREMENT_ID=
