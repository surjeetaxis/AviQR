: 8px;\n  color: var(--gray-700);\n}\n.topbar-menu:hover { background: var(--gray-100); }\n\n.topbar-search {\n  flex: 1;\n  max-width: 440px;\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n.topbar-search input {\n  width: 100%;\n  height: 38px;\n  padding: 0 56px 0 38px;\n  background: var(--gray-100);\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  font-size: 13px;\n  color: var(--gray-900);\n  transition: background .15s, border-color .15s;\n}\n.topbar-search input:focus {\n  outline: none;\n  background: var(--white);\n  border-color: var(--green);\n}\n.topbar-search input::placeholder { color: var(--gray-400); }\n\n.topbar-search-icon {\n  position: absolute;\n  left: 12px;\n  color: var(--gray-400);\n  pointer-events: none;\n}\n\n.topbar-kbd {\n  position: absolute;\n  right: 10px;\n  font-family: var(--font-sans);\n  font-size: 10px;\n  font-weight: 500;\n  color: var(--gray-500);\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: 4px;\n  padding: 2px 6px;\n  pointer-events: none;\n}\n\n.topbar-actions {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  margin-left: auto;\n}\n\n.topbar-icon-btn {\n  position: relative;\n  width: 38px;\n  height: 38px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--gray-600);\n  transition: background .15s, color .15s;\n}\n.topbar-icon-btn:hover {\n  background: var(--gray-100);\n  color: var(--gray-900);\n}\n\n.topbar-notif-dot {\n  position: absolute;\n  top: 9px;\n  right: 9px;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--red);\n  border: 2px solid var(--white);\n}\n\n.topbar-divider {\n  width: 1px;\n  height: 24px;\n  background: var(--gray-200);\n  margin: 0 4px;\n}\n\n.topbar-profile {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 4px 10px 4px 4px;\n  border-radius: var(--radius-pill);\n  transition: background .15s;\n}\n.topbar-profile:hover { background: var(--gray-100); }\n\n.topbar-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: 50%;\n  background: var(--green);\n  color: var(--white);\n  font-size: 12px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.topbar-profile-text {\n  display: flex;\n  flex-direction: column;\n  text-align: left;\n}\n.topbar-profile-name {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--gray-900);\n}\n.topbar-profile-role {\n  font-size: 11px;\n  color: var(--gray-500);\n}\n\n@media (max-width: 900px) {\n  .topbar { padding: 0 16px; }\n  .topbar-menu { display: flex; }\n  .topbar-search { max-width: none; }\n  .topbar-kbd { display: none; }\n  .topbar-profile-text { display: none; }\n  .topbar-profile { padding: 4px; }\n}\n\n/* ─── Profile dropdown ────────────────────────────────────────────────────── */\n.topbar-profile-wrap { position: relative; }\n.topbar-profile { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: var(--radius-md); transition: background .12s; }\n.topbar-profile:hover { background: var(--gray-100); }\n\n.topbar-dropdown {\n  position: absolute;\n  top: calc(100% + 8px);\n  right: 0;\n  width: 220px;\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-lg);\n  z-index: 100;\n  overflow: hidden;\n}\n.topbar-dropdown-header { padding: 12px 14px; }\n.topbar-dropdown-name { font-size: 13px; font-weight: 700; color: var(--gray-900); }\n.topbar-dropdown-email { font-size: 11.5px; color: var(--gray-400); margin-top: 2px; }\n.topbar-dropdown-divider { height: 1px; background: var(--gray-100); }\n.topbar-dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 10px 14px;\n  font-size: 13px;\n  color: var(--gray-700);\n  text-align: left;\n  transition: background .12s;\n}\n.topbar-dropdown-item:hover { background: var(--gray-50); }\n.topbar-dropdown-logout { color: var(--red); }\n.topbar-dropdown-logout:hover { background: var(--red-bg); }\n"],["STYLE",{},".layout {\n  display: flex;\n  min-height: 100vh;\n  background: var(--gray-50);\n}\n\n.layout-main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  margin-left: var(--sidebar-w);\n  transition: margin-left .2s ease;\n}\n\n.layout-content {\n  flex: 1;\n  padding: 24px 32px 48px;\n  max-width: 1400px;\n  width: 100%;\n}\n\n.layout-backdrop {\n  display: none;\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.4);\n  z-index: 40;\n}\n\n@media (max-width: 900px) {\n  .layout-main { margin-left: 0; }\n  .layout-content { padding: 20px 16px 40px; }\n  .layout-backdrop { display: block; }\n}\n"],["STYLE",{},"/* ─── Landing Page ────────────────────────────────────────────────────────── */\n.landing { font-family: var(--font-sans); color: var(--gray-900); background: var(--white); overflow-x: hidden; }\n\n/* Nav */\n.land-nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,.92); backdrop-filter: blur(12px); border-bottom: 1px solid var(--gray-100); }\n.land-nav-inner { max-width: 1200px; margin: 0 auto; padding: 0 32px; height: 64px; display: flex; align-items: center; gap: 32px; }\n.land-logo { display: flex; align-items: center; gap: 10px; }\n.land-logo-mark { width: 32px; height: 32px; border-radius: 8px; background: var(--gray-900); display: flex; align-items: center; justify-content: center; padding: 2px; }\n.land-wordmark { font-size: 20px; font-weight: 800; letter-spacing: -.02em; color: var(--gray-900); }\n.land-wordmark em { font-style: normal; color: var(--green); }\n.land-nav-links { display: flex; gap: 24px; margin-left: 32px; }\n.land-nav-links a { font-size: 14px; color: var(--gray-500); font-weight: 500; transition: color .15s; }\n.land-nav-links a:hover { color: var(--gray-900); }\n.land-nav-cta { margin-left: auto; display: flex; gap: 10px; align-items: center; }\n.btn-ghost-nav { height: 38px; padding: 0 16px; border-radius: var(--radius-md); font-size: 13.5px; font-weight: 500; color: var(--gray-700); transition: background .15s; }\n.btn-ghost-nav:hover { background: var(--gray-100); }\n.btn-primary-nav { height: 38px; padding: 0 18px; border-radius: var(--radius-md); font-size: 13.5px; font-weight: 600; background: var(--gray-900); color: var(--white); transition: background .15s; }\n.btn-primary-nav:hover { background: var(--green-dark); }\n\n/* Hero */\n.hero { max-width: 1200px; margin: 0 auto; padding: 80px 32px 64px; display: grid; grid-template-columns: 1fr 480px; gap: 64px; align-items: center; }\n.hero-inner { display: flex; flex-direction: column; gap: 24px; }\n.hero-eyebrow { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--green-dark); }\n.eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: ticker-pulse 2s infinite; }\n@keyframes ticker-pulse { 0%,100%{box-shadow:0 0 0 0 rgba(29,158,117,.5)} 70%{box-shadow:0 0 0 8px rgba(29,158,117,0)} }\n.hero-headline { font-size: 56px; font-weight: 800; line-height: 1.05; letter-spacing: -.03em; color: var(--gray-900); }\n.hero-accent { color: var(--green); }\n.hero-sub { font-size: 17px; color: var(--gray-500); line-height: 1.65; max-width: 480px; }\n.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }\n.btn-hero-primary { display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 24px; border-radius: var(--radius-md); font-size: 15px; font-weight: 600; background: var(--green); color: var(--white); transition: background .15s, transform .1s; }\n.btn-hero-primary:hover { background: var(--green-dark); transform: translateY(-1px); }\n.btn-hero-secondary { display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; border-radius: var(--radius-md); font-size: 14.5px; font-weight: 500; background: var(--white); color: var(--gray-700); border: 1.5px solid var(--gray-200); transition: border-color .15s; }\n.btn-hero-secondary:hover { border-color: var(--green); color: var(--green-dark); }\n.hero-proof { display: flex; gap: 18px; flex-wrap: wrap; }\n.hero-proof-item { display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--gray-500); }\n.hero-proof-item svg { color: var(--green); }\n\n/* Hero visual */\n.hero-visual { position: relative; }\n.hero-dash { background: var(--gray-900); border-radius: 20px; padding: 20px; box-shadow: 0 24px 64px rgba(0,0,0,.18); }\n.hero-dash-card { background: #1a1a1a; border-radius: 14px; padding: 16px; }\n.hero-dash-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }\n.hero-dash-title { font-size: 13px; font-weight: 600; color: var(--gray-300); }\n.hero-live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: ticker-pulse 2s infinite; }\n.hero-order-row { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px; margin-bottom: 6px; background: #222; }\n.hero-order-row.hero-order-new { background: rgba(29,158,117,.12); border: 1px solid rgba(29,158,117,.2); }\n.hero-order-id { font-size: 12px; font-weight: 700; color: var(--gray-300); min-width: 42px; font-variant-numeric: tabular-nums; }\n.hero-order-table { font-size: 12px; color: var(--gray-400); flex: 1; }\n.hero-order-badge { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 99px; }\n.hero-order-badge.new  { background: rgba(29,158,117,.2); color: #5DCAA5; }\n.hero-order-badge.prep { background: rgba(37,99,235,.2); color: #60A5FA; }\n.hero-order-badge.ready { background: rgba(217,119,6,.2); color: #FBBF24; }\n.hero-stats-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-top: 14px; }\n.hero-mini-stat { background: #222; border-radius: 8px; padding: 10px; text-align: center; }\n.hero-mini-val { font-size: 16px; font-weight: 700; color: var(--white); }\n.hero-mini-label { font-size: 10px; color: var(--gray-500); margin-top: 2px; }\n.hero-qr-float { position: absolute; bottom: -16px; right: -16px; background: var(--white); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--gray-800); box-shadow: 0 8px 24px rgba(0,0,0,.12); border: 1px solid var(--gray-100); }\n\n/* Stats band */\n.stats-band { background: var(--gray-900); padding: 32px; display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; }\n.stat-item { text-align: center; }\n.stat-value { font-size: 32px; font-weight: 800; color: var(--white); letter-spacing: -.02em; }\n.stat-label { font-size: 13px; color: var(--gray-400); margin-top: 4px; }\n\n/* Section shared */\n.section-header { text-align: center; margin-bottom: 48px; }\n.section-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--green); margin-bottom: 12px; }\n.section-title { font-size: 36px; font-weight: 800; letter-spacing: -.02em; color: var(--gray-900); margin-bottom: 14px; }\n.section-sub { font-size: 16px; color: var(--gray-500); max-width: 560px; margin: 0 auto; line-height: 1.6; }\n\n/* Features */\n.features-section { max-width: 1200px; margin: 80px auto; padding: 0 32px; }\n.features-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }\n.feature-card { background: var(--gray-50); border: 1px solid var(--gray-100); border-radius: var(--radius-lg); padding: 28px; transition: border-color .15s, box-shadow .15s; }\n.feature-card:hover { border-color: var(--green-mid); box-shadow: 0 4px 16px rgba(29,158,117,.08); }\n.feature-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--green-light); color: var(--green-dark); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }\n.feature-title { font-size: 16px; font-weight: 700; color: var(--gray-900); margin-bottom: 8px; }\n.feature-desc { font-size: 13.5px; color: var(--gray-500); line-height: 1.6; }\n\n/* Verticals */\n.verticals-section { background: var(--gray-50); padding: 80px 32px; }\n.verticals-section .section-header { margin-bottom: 32px; }\n.verticals-grid { max-width: 900px; margin: 0 auto 48px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }\n.vertical-chip { display: flex; align-items: center; gap: 10px; padding: 10px 20px; border-radius: var(--radius-pill); font-size: 14px; font-weight: 600; border: 1.5px solid; }\n.vertical-green  { background: var(--green-light);  color: var(--green-darker); border-color: #A7F3D0; }\n.vertical-amber  { background: var(--amber-bg);     color: var(--amber);       border-color: #FDE68A; }\n.vertical-blue   { background: var(--blue-bg);      color: var(--blue);        border-color: #BFDBFE; }\n.vertical-purple { background: var(--purple-bg);    color: var(--purple);      border-color: #C4B5FD; }\n.vertical-red    { background: var(--red-bg);       color: var(--red);         border-color: #FECACA; }\n\n/* How it works */\n.how-it-works { max-width: 900px; margin: 0 auto; display: flex; align-items: flex-start; gap: 0; }\n.hiw-step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; flex: 1; }\n.hiw-num { width: 40px; height: 40px; border-radius: 50%; background: var(--green); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 800; flex-shrink: 0; }\n.hiw-text { font-size: 13.5px; color: var(--gray-600); line-height: 1.6; }\n.hiw-text strong { display: block; font-size: 14px; font-weight: 700; color: var(--gray-900); margin-bottom: 4px; }\n.hiw-arrow { color: var(--gray-300); padding-top: 10px; flex-shrink: 0; }\n\n/* Pricing */\n.pricing-section { max-width: 1100px; margin: 80px auto; padding: 0 32px; }\n.pricing-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }\n.pricing-card { position: relative; background: var(--white); border: 1.5px solid var(--gray-200); border-radius: var(--radius-xl); padding: 32px; display: flex; flex-direction: column; gap: 16px; transition: box-shadow .15s; }\n.pricing-card:hover { box-shadow: var(--shadow-lg); }\n.pricing-card.pricing-primary { background: var(--gray-900); border-color: var(--gray-900); color: var(--white); }\n.pricing-tag { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--green); color: var(--white); font-size: 11px; font-weight: 700; padding: 3px 14px; border-radius: 99px; white-space: nowrap; }\n.pricing-name { font-size: 18px; font-weight: 700; }\n.pricing-card.pricing-primary .pricing-name { color: var(--white); }\n.pricing-price { font-size: 36px; font-weight: 800; letter-spacing: -.02em; }\n.pricing-period { font-size: 16px; font-weight: 400; color: var(--gray-400); }\n.pricing-card.pricing-primary .pricing-period { color: var(--gray-500); }\n.pricing-desc { font-size: 13px; color: var(--gray-500); }\n.pricing-card.pricing-primary .pricing-desc { color: var(--gray-400); }\n.pricing-features { list-style: none; display: flex; flex-direction: column; gap: 9px; flex: 1; }\n.pricing-features li { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--gray-700); }\n.pricing-features li svg { color: var(--green); flex-shrink: 0; }\n.pricing-card.pricing-primary .pricing-features li { color: var(--gray-300); }\n.pricing-card.pricing-primary .pricing-features li svg { color: var(--green-mid); }\n.btn-pricing-primary { height: 44px; border-radius: var(--radius-md); font-size: 14px; font-weight: 600; background: var(--green); color: var(--white); transition: background .15s; margin-top: 8px; }\n.btn-pricing-primary:hover { background: var(--green-dark); }\n.btn-pricing-secondary { height: 44px; border-radius: var(--radius-md); font-size: 14px; font-weight: 600; background: var(--white); color: var(--gray-900); border: 1.5px solid var(--gray-200); transition: border-color .15s; margin-top: 8px; }\n.btn-pricing-secondary:hover { border-color: var(--green); color: var(--green-dark); }\n\n/* Testimonials */\n.testimonials-section { background: var(--gray-50); padding: 80px 32px; }\n.testimonials-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }\n.testimonial-card { background: var(--white); border: 1px solid var(--gray-100); border-radius: var(--radius-xl); padding: 28px; box-shadow: var(--shadow-card); }\n.testimonial-stars { font-size: 16px; color: #FBBF24; margin-bottom: 12px; }\n.testimonial-text { font-size: 14px; color: var(--gray-700); line-height: 1.7; margin-bottom: 20px; }\n.testimonial-author { display: flex; align-items: center; gap: 12px; }\n.testimonial-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--green); color: var(--white); font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.testimonial-name { font-size: 13.5px; font-weight: 700; color: var(--gray-900); }\n.testimonial-shop { font-size: 12px; color: var(--gray-400); }\n\n/* CTA Banner */\n.cta-banner { background: linear-gradient(135deg,#085041,#1D9E75); padding: 80px 32px; text-align: center; }\n.cta-banner-inner { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 20px; }\n.cta-qr-icon { color: rgba(255,255,255,.5); }\n.cta-title { font-size: 40px; font-weight: 800; color: var(--white); letter-spacing: -.02em; }\n.cta-sub { font-size: 16px; color: rgba(255,255,255,.7); line-height: 1.6; }\n.cta-actions { display: flex; flex-direction: column; align-items: center; gap: 12px; }\n.btn-cta-primary { height: 52px; padding: 0 32px; border-radius: var(--radius-md); font-size: 16px; font-weight: 700; background: var(--white); color: var(--green-darker); transition: transform .1s, box-shadow .15s; }\n.btn-cta-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.15); }\n.btn-cta-ghost { font-size: 13.5px; color: rgba(255,255,255,.65); font-weight: 500; }\n.btn-cta-ghost:hover { color: var(--white); }\n\n/* Footer */\n.land-footer { background: var(--gray-900); padding: 48px 32px 32px; }\n.footer-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 280px 1fr; gap: 48px; }\n.footer-tagline { font-size: 13px; color: var(--gray-500); margin-bottom: 8px; }\n.footer-copy { font-size: 12px; color: var(--gray-600); }\n.footer-links { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }\n.footer-col { display: flex; flex-direction: column; gap: 10px; }\n.footer-col-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--gray-500); margin-bottom: 4px; }\n.footer-col a { font-size: 13.5px; color: var(--gray-400); transition: color .12s; }\n.footer-col a:hover { color: var(--white); }\n\n/* ── Responsive ── */\n@media (max-width: 1024px) {\n  .hero { grid-template-columns: 1fr; gap: 40px; }\n  .hero-headline { font-size: 42px; }\n  .hero-visual { max-width: 420px; }\n  .features-grid { grid-template-columns: repeat(2,1fr); }\n  .pricing-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }\n  .testimonials-grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }\n}\n@media (max-width: 720px) {\n  .land-nav-links { display: none; }\n  .hero { padding: 48px 20px 40px; }\n  .hero-headline { font-size: 34px; }\n  .stats-band { grid-template-columns: repeat(2,1fr); }\n  .features-grid { grid-template-columns: 1fr; }\n  .how-it-works { flex-direction: column; align-items: center; }\n  .hiw-arrow { transform: rotate(90deg); }\n  .footer-inner { grid-template-columns: 1fr; }\n  .footer-links { grid-template-columns: repeat(2,1fr); }\n}\n"],["STYLE",{},"/* ─── Auth shared styles ──────────────────────────────────────────────────── */\n.auth-page {\n  min-height: 100vh;\n  display: grid;\n  grid-template-columns: 420px 1fr;\n  background: var(--white);\n}\n.auth-page-simple {\n  grid-template-columns: 1fr;\n  background: var(--gray-50);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n}\n.auth-simple-card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-xl);\n  padding: 36px;\n  width: 100%;\n  max-width: 440px;\n  box-shadow: var(--shadow-lg);\n}\n\n/* Left panel */\n.auth-left {\n  background: var(--gray-900);\n  display: flex;\n  flex-direction: column;\n  padding: 32px;\n  min-height: 100vh;\n  position: sticky;\n  top: 0;\n}\n.auth-brand { margin-bottom: auto; }\n.auth-brand-logo {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.auth-brand-name {\n  font-size: 22px;\n  font-weight: 800;\n  letter-spacing: -.02em;\n  color: var(--white);\n}\n.auth-brand-name em { font-style: normal; color: var(--green-mid); }\n\n.auth-left-body {\n  margin-top: 48px;\n  margin-bottom: 48px;\n}\n.auth-left-title {\n  font-size: 32px;\n  font-weight: 800;\n  color: var(--white);\n  letter-spacing: -.025em;\n  line-height: 1.15;\n  margin-bottom: 16px;\n}\n.auth-left-sub {\n  font-size: 15px;\n  color: var(--gray-400);\n  line-height: 1.65;\n  margin-bottom: 24px;\n}\n.auth-left-badges { display: flex; flex-direction: column; gap: 10px; }\n.auth-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--gray-300);\n  background: rgba(255,255,255,.06);\n  border-radius: 8px;\n  padding: 8px 12px;\n  width: fit-content;\n}\n\n/* Register steps visual */\n.register-steps-visual { display: flex; flex-direction: column; gap: 16px; margin-top: 32px; }\n.reg-step { display: flex; align-items: center; gap: 12px; }\n.reg-step-dot {\n  width: 28px; height: 28px;\n  border-radius: 50%;\n  background: rgba(255,255,255,.1);\n  color: var(--gray-400);\n  font-size: 12px; font-weight: 700;\n  display: flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n  transition: background .2s, color .2s;\n}\n.reg-step span { font-size: 13.5px; color: var(--gray-500); }\n.reg-step.active .reg-step-dot { background: var(--green); color: var(--white); }\n.reg-step.active span { color: var(--gray-200); font-weight: 600; }\n.reg-step.done .reg-step-dot { background: var(--green-darker); color: var(--green-mid); }\n\n/* Right panel */\n.auth-right {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 32px;\n  overflow-y: auto;\n}\n.auth-form-wrap {\n  width: 100%;\n  max-width: 460px;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n.auth-form-header {}\n.auth-title {\n  font-size: 26px;\n  font-weight: 800;\n  color: var(--gray-900);\n  letter-spacing: -.02em;\n  margin-bottom: 6px;\n}\n.auth-subtitle { font-size: 14px; color: var(--gray-500); }\n.auth-link { color: var(--green-dark); font-weight: 600; text-decoration: none; }\n.auth-link:hover { color: var(--green); }\n\n/* Mode toggle */\n.auth-mode-toggle {\n  display: flex;\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  overflow: hidden;\n}\n.mode-btn {\n  flex: 1; height: 40px;\n  font-size: 13px; font-weight: 500;\n  color: var(--gray-500);\n  background: var(--white);\n  display: flex; align-items: center; justify-content: center; gap: 6px;\n  transition: background .12s, color .12s;\n}\n.mode-btn.active { background: var(--gray-900); color: var(--white); }\n\n/* Role picker */\n.role-picker {}\n.role-picker-label { font-size: 12px; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }\n.role-picker-grid { display: flex; flex-wrap: wrap; gap: 6px; }\n.role-chip {\n  height: 30px; padding: 0 12px;\n  border-radius: var(--radius-pill);\n  font-size: 12px; font-weight: 500;\n  background: var(--gray-100); color: var(--gray-600);\n  border: 1.5px solid transparent;\n  transition: background .12s, color .12s, border-color .12s;\n}\n.role-chip.active { background: var(--green-light); color: var(--green-darker); border-color: var(--green); }\n.role-chip:hover { border-color: var(--green); }\n\n/* Form */\n.auth-form { display: flex; flex-direction: column; gap: 16px; }\n.auth-error {\n  background: var(--red-bg);\n  border: 1px solid #FECACA;\n  border-radius: var(--radius-md);\n  padding: 10px 14px;\n  font-size: 13px;\n  color: var(--red);\n}\n.field { display: flex; flex-direction: column; gap: 5px; }\n.field-label {\n  font-size: 12.5px; font-weight: 600; color: var(--gray-700);\n  display: flex; align-items: center;\n}\n.field-input {\n  height: 44px;\n  border: 1.5px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  padding: 0 14px;\n  font-size: 14px; color: var(--gray-900);\n  background: var(--white);\n  transition: border-color .15s;\n  width: 100%;\n}\n.field-input:focus { outline: none; border-color: var(--green); }\n.field-input-wrap { position: relative; }\n.field-input-wrap .field-input { padding-right: 44px; }\n.field-eye {\n  position: absolute; right: 12px; top: 50%; transform: translateY(-50%);\n  color: var(--gray-400);\n  display: flex; align-items: center;\n  transition: color .12s;\n}\n.field-eye:hover { color: var(--gray-700); }\n\n.field-phone-wrap { display: flex; align-items: center; gap: 0; }\n.field-dial {\n  height: 44px; padding: 0 12px;\n  background: var(--gray-100);\n  border: 1.5px solid var(--gray-200);\n  border-right: none;\n  border-radius: var(--radius-md) 0 0 var(--radius-md);\n  font-size: 14px; font-weight: 600; color: var(--gray-700);\n  display: flex; align-items: center;\n  flex-shrink: 0;\n}\n.field-input-phone {\n  border-radius: 0;\n  border-left: none;\n  flex: 1;\n  border-right: none;\n}\n.btn-send-otp {\n  height: 44px; padding: 0 14px;\n  background: var(--green);\n  color: var(--white);\n  font-size: 12.5px; font-weight: 600;\n  border-radius: 0 var(--radius-md) var(--radius-md) 0;\n  border: 1.5px solid var(--green);\n  white-space: nowrap;\n  transition: background .12s;\n}\n.btn-send-otp:hover { background: var(--green-dark); }\n.otp-hint { font-size: 11px; font-weight: 400; color: var(--gray-400); margin-left: 8px; }\n.otp-input { font-size: 22px; letter-spacing: 8px; text-align: center; font-variant-numeric: tabular-nums; }\n.resend-btn { font-size: 12.5px; color: var(--green-dark); font-weight: 500; margin-top: 4px; }\n\n.btn-auth-primary {\n  height: 48px;\n  border-radius: var(--radius-md);\n  font-size: 15px; font-weight: 600;\n  background: var(--green);\n  color: var(--white);\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n  transition: background .15s, transform .1s;\n  border: none;\n}\n.btn-auth-primary:hover { background: var(--green-dark); transform: translateY(-1px); }\n.btn-auth-primary:disabled { opacity: .6; cursor: not-allowed; transform: none; }\n.btn-auth-secondary {\n  height: 48px;\n  border-radius: var(--radius-md);\n  font-size: 14px; font-weight: 500;\n  background: var(--white);\n  color: var(--gray-700);\n  border: 1.5px solid var(--gray-200);\n  transition: border-color .12s;\n  padding: 0 20px;\n}\n.btn-auth-secondary:hover { border-color: var(--gray-400); }\n\n.auth-terms { font-size: 12px; color: var(--gray-400); line-height: 1.6; }\n\n/* Demo quick-login */\n.demo-logins {\n  border-top: 1px solid var(--gray-100);\n  padding-top: 16px;\n  margin-top: 4px;\n}\n.demo-logins-label { font-size: 11.5px; font-weight: 600; color: var(--gray-400); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 10px; }\n.demo-logins-grid { display: flex; flex-wrap: wrap; gap: 6px; }\n.demo-btn {\n  height: 34px; padding: 0 14px;\n  border-radius: var(--radius-md);\n  font-size: 12.5px; font-weight: 600;\n  background: var(--gray-100); color: var(--gray-700);\n  border: 1px solid var(--gray-200);\n  transition: background .12s, border-color .12s;\n}\n.demo-btn:hover { background: var(--green-light); color: var(--green-darker); border-color: var(--green); }\n\n/* Account type cards */\n.account-types-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n.account-type-card {\n  position: relative;\n  display: flex; flex-direction: column; align-items: flex-start;\n  padding: 16px;\n  border: 1.5px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  text-align: left;\n  transition: border-color .15s, background .15s;\n  cursor: pointer;\n}\n.account-type-card:hover { border-color: var(--green); }\n.account-type-card.active { border-color: var(--green); background: var(--green-light); }\n.at-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--gray-100); color: var(--gray-600); display: flex; align-items: center; justify-content: center; margin-bottom: 10px; }\n.account-type-card.active .at-icon { background: var(--green); color: var(--white); }\n.at-label { font-size: 13.5px; font-weight: 700; color: var(--gray-900); margin-bottom: 4px; }\n.at-desc { font-size: 11.5px; color: var(--gray-500); line-height: 1.4; }\n.at-check { position: absolute; top: 10px; right: 10px; width: 20px; height: 20px; background: var(--green); color: var(--white); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; }\n\n/* OTP sent notice */\n.otp-sent-notice {\n  background: var(--green-light);\n  border: 1px solid #A7F3D0;\n  border-radius: var(--radius-md);\n  padding: 12px 14px;\n  font-size: 13.5px;\n  color: var(--green-darker);\n}\n.otp-sent-notice strong { font-weight: 700; }\n\n/* Success */\n.auth-success {\n  display: flex; flex-direction: column; align-items: center; gap: 16px;\n  text-align: center; margin-top: 32px;\n}\n.auth-success h2 { font-size: 22px; font-weight: 700; color: var(--gray-900); }\n.auth-success p { font-size: 14px; color: var(--gray-500); line-height: 1.6; }\n\n/* Shared form grid */\n.form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n\n@media (max-width: 780px) {\n  .auth-page { grid-template-columns: 1fr; }\n  .auth-left { display: none; }\n  .auth-right { padding: 24px 20px; align-items: flex-start; padding-top: 40px; }\n  .account-types-grid { grid-template-columns: 1fr; }\n  .form-row-2 { grid-template-columns: 1fr; }\n}\n\n/* ── Register ─────────────────────────────────────────────────────────── */\n.auth-steps {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 20px;\n}\n.auth-step {\n  font-size: 12px;\n  font-weight: 600;\n  color: #9CA3AF;\n  flex: 1;\n  text-align: center;\n  padding: 6px;\n  border-radius: 6px;\n}\n.auth-step.active { background: #E1F5EE; color: #0F6E56; }\n.auth-step-divider { width: 24px; height: 1px; background: #E5E7EB; flex-shrink: 0; }\n\n.register-type-grid { display: flex; flex-direction: column; gap: 8px; }\n.register-type-card {\n  display: flex; align-items: flex-start; gap: 12;\n  padding: 14px; background: #fff; border: 1.5px solid #E5E7EB;\n  border-radius: 10px; cursor: pointer; text-align: left;\n  transition: border-color .15s, background .15s; position: relative;\n  width: 100%;\n}\n.register-type-card.selected { border-color: #1D9E75; background: #E1F5EE; }\n.register-type-card:hover:not(.selected) { border-color: #D1D5DB; }\n.type-label { font-size: 14px; font-weight: 700; color: #111827; }\n.type-desc  { font-size: 12px; color: #6B7280; margin-top: 2px; }\n.type-check { position: absolute; right: 14px; top: 14px; color: #1D9E75; font-weight: 700; }\n\n/* Auth buttons */\n.auth-btn {\n  display: flex; align-items: center; justify-content: center; gap: 6px;\n  width: 100%; height: 48px; background: #1D9E75; color: #fff;\n  border: none; border-radius: 10px; font-size: 15px; font-weight: 700;\n  cursor: pointer; transition: background .15s;\n}\n.auth-btn:hover { background: #0F6E56; }\n.auth-btn:disabled { opacity: 0.6; cursor: not-allowed; }\n.auth-btn-ghost {\n  height: 48px; padding: 0 20px; background: none; border: 1px solid #E5E7EB;\n  border-radius: 10px; font-size: 14px; font-weight: 600; color: #374151; cursor: pointer;\n}\n.auth-btn-ghost:hover { background: #F3F4F6; }\n.auth-error {\n  background: #FEE2E2; border: 1px solid #FCA5A5; border-radius: 8px;\n  padding: 10px 14px; font-size: 13px; color: #DC2626; margin-bottom: 14px;\n}\n"],["STYLE",{},".stat-card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 18px;\n  box-shadow: var(--shadow-card);\n  transition: border-color .15s, transform .15s;\n}\n.stat-card:hover {\n  border-color: var(--gray-300);\n  transform: translateY(-1px);\n}\n\n.stat-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 16px;\n}\n\n.stat-card-icon {\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.stat-card-icon.icon-green  { background: var(--green-light); color: var(--green-dark); }\n.stat-card-icon.icon-blue   { background: var(--blue-bg);     color: var(--blue); }\n.stat-card-icon.icon-purple { background: var(--purple-bg);   color: var(--purple); }\n.stat-card-icon.icon-amber  { background: var(--amber-bg);    color: var(--amber); }\n.stat-card-icon.icon-red    { background: var(--red-bg);      color: var(--red); }\n\n.stat-card-change {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 11.5px;\n  font-weight: 600;\n  padding: 3px 8px;\n  border-radius: var(--radius-pill);\n}\n.stat-card-change.positive { color: var(--green-darker); background: var(--green-light); }\n.stat-card-change.negative { color: var(--red);          background: var(--red-bg); }\n\n.stat-card-value {\n  font-size: 26px;\n  font-weight: 700;\n  color: var(--gray-900);\n  letter-spacing: -.02em;\n  line-height: 1.1;\n}\n\n.stat-card-label {\n  font-size: 13px;\n  color: var(--gray-500);\n  margin-top: 4px;\n}\n\n.stat-card-change-label {\n  font-size: 11px;\n  color: var(--gray-400);\n  margin-top: 8px;\n}\n\n/* ── StatCard ──────────────────────────────────────────────────── */\n.stat-card {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 18px 20px;\n  box-shadow: var(--shadow-card);\n}\n.stat-card-icon {\n  width: 46px; height: 46px;\n  border-radius: 12px;\n  display: flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n}\n.stat-card-body { flex: 1; min-width: 0; }\n.stat-card-value { font-size: 26px; font-weight: 800; letter-spacing: -.03em; line-height: 1; }\n.stat-card-label { font-size: 12px; color: var(--gray-500); margin-top: 4px; }\n.stat-card-sub   { font-size: 11px; margin-top: 3px; font-weight: 500; }\n"],["STYLE",{},".order-row {\n  display: grid;\n  grid-template-columns: 80px 1fr auto 90px auto;\n  align-items: center;\n  gap: 14px;\n  padding: 12px 4px;\n  border-bottom: 1px solid var(--gray-100);\n  transition: background .12s;\n}\n.order-row:last-child { border-bottom: none; }\n.order-row:hover { background: var(--gray-50); }\n\n.order-row-id {\n  display: flex;\n  flex-direction: column;\n}\n.order-id-text {\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--gray-900);\n  font-variant-numeric: tabular-nums;\n}\n.order-time {\n  font-size: 11px;\n  color: var(--gray-400);\n  margin-top: 1px;\n}\n\n.order-row-details { min-width: 0; }\n.order-table {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--gray-900);\n}\n.order-meta {\n  font-size: 11.5px;\n  color: var(--gray-500);\n  margin-top: 1px;\n}\n\n.order-row-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  padding: 4px 9px;\n  border-radius: var(--radius-pill);\n  white-space: nowrap;\n}\n.order-row-status.status-new       { background: var(--amber-bg);  color: var(--amber); }\n.order-row-status.status-preparing { background: var(--blue-bg);   color: var(--blue); }\n.order-row-status.status-ready     { background: var(--green-light); color: var(--green-darker); }\n.order-row-status.status-served    { background: var(--gray-100);  color: var(--gray-600); }\n\n.order-row-amount {\n  font-size: 13.5px;\n  font-weight: 700;\n  color: var(--gray-900);\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n}\n\n.order-row-actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.order-action-btn {\n  height: 30px;\n  padding: 0 12px;\n  border-radius: 8px;\n  font-size: 12px;\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  transition: background .15s, border-color .15s;\n  white-space: nowrap;\n}\n.order-action-primary {\n  background: var(--gray-900);\n  color: var(--white);\n}\n.order-action-primary:hover { background: var(--gray-700); }\n.order-action-secondary {\n  background: var(--white);\n  color: var(--gray-700);\n  border: 1px solid var(--gray-200);\n}\n.order-action-secondary:hover { border-color: var(--gray-400); }\n\n.order-action-icon {\n  width: 30px;\n  height: 30px;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--gray-400);\n  transition: background .15s, color .15s;\n}\n.order-action-icon:hover {\n  background: var(--gray-100);\n  color: var(--gray-700);\n}\n\n@media (max-width: 720px) {\n  .order-row {\n    grid-template-columns: 1fr auto;\n    gap: 10px;\n    padding: 14px 4px;\n  }\n  .order-row-id      { grid-column: 1; grid-row: 1; }\n  .order-row-details { grid-column: 1; grid-row: 2; }\n  .order-row-status  { grid-column: 2; grid-row: 1; }\n  .order-row-amount  { grid-column: 2; grid-row: 2; text-align: right; }\n  .order-row-actions { grid-column: 1 / -1; grid-row: 3; justify-content: flex-start; margin-top: 4px; }\n}\n\n/* ── OrderRow ──────────────────────────────────────────────────── */\n.order-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--gray-100);\n  flex-wrap: wrap;\n}\n.order-row:last-child { border-bottom: none; }\n.order-row-left {\n  display: flex; align-items: center; gap: 6px; flex-shrink: 0;\n}\n.order-row-num  { font-size: 13px; font-weight: 700; color: var(--gray-900); }\n.order-row-sep  { color: var(--gray-300); }\n.order-row-customer { font-size: 13px; color: var(--gray-700); }\n.order-row-table { font-size: 11px; background: var(--gray-100); border-radius: 4px; padding: 1px 6px; color: var(--gray-600); font-weight: 600; }\n.order-row-time  { font-size: 11px; color: var(--gray-400); margin-left: 2px; }\n.order-row-items { flex: 1; display: flex; flex-wrap: wrap; gap: 4px; min-width: 0; }\n.order-row-item  { font-size: 11.5px; background: var(--gray-100); border-radius: 4px; padding: 2px 8px; color: var(--gray-600); white-space: nowrap; }\n.order-row-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; margin-left: auto; }\n.order-row-amount { font-size: 14px; font-weight: 700; color: var(--gray-900); }\n.order-row-status { font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }\n.order-row-advance {\n  display: inline-flex; align-items: center; gap: 4px;\n  background: var(--green); color: var(--white);\n  border: none; border-radius: 8px; padding: 5px 12px;\n  font-size: 11.5px; font-weight: 600; cursor: pointer;\n  white-space: nowrap; transition: background .15s;\n}\n.order-row-advance:hover { background: var(--green-dark); }\n"],["STYLE",{},"/* ─── Page header ─────────────────────────────────────────────────────────── */\n.dashboard { display: flex; flex-direction: column; gap: 20px; }\n\n.page-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n.page-title {\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -.02em;\n  color: var(--gray-900);\n}\n.page-subtitle {\n  font-size: 14px;\n  color: var(--gray-500);\n  margin-top: 4px;\n}\n.page-header-actions { display: flex; gap: 10px; }\n\n/* ─── Buttons ─────────────────────────────────────────────────────────────── */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  height: 38px;\n  padding: 0 16px;\n  border-radius: var(--radius-md);\n  font-size: 13px;\n  font-weight: 500;\n  transition: background .15s, border-color .15s, transform .1s, opacity .15s;\n  white-space: nowrap;\n}\n.btn:active { transform: scale(.98); }\n.btn-primary {\n  background: var(--gray-900);\n  color: var(--white);\n}\n.btn-primary:hover { background: var(--gray-700); }\n.btn-secondary {\n  background: var(--white);\n  color: var(--gray-900);\n  border: 1px solid var(--gray-200);\n}\n.btn-secondary:hover { border-color: var(--gray-400); }\n.btn-ghost {\n  background: transparent;\n  color: var(--green-dark);\n  font-weight: 600;\n  padding: 0 14px;\n  height: 34px;\n}\n.btn-ghost:hover { background: var(--green-light); }\n.btn-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--green-dark);\n  font-size: 13px;\n  font-weight: 500;\n}\n.btn-link:hover { color: var(--green); }\n\n/* ─── Live ticker ─────────────────────────────────────────────────────────── */\n.live-ticker {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: linear-gradient(135deg, #E1F5EE, #F0FAF6);\n  border: 1px solid #BFE5D4;\n  border-radius: var(--radius-md);\n  padding: 12px 16px;\n  font-size: 13px;\n}\n.live-ticker-pulse {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--green);\n  box-shadow: 0 0 0 0 rgba(29, 158, 117, 0.5);\n  animation: ticker-pulse 2s infinite;\n  flex-shrink: 0;\n}\n@keyframes ticker-pulse {\n  0%   { box-shadow: 0 0 0 0 rgba(29, 158, 117, 0.5); }\n  70%  { box-shadow: 0 0 0 8px rgba(29, 158, 117, 0); }\n  100% { box-shadow: 0 0 0 0 rgba(29, 158, 117, 0); }\n}\n.live-ticker-text { flex: 1; color: var(--green-darker); }\n.live-ticker-text strong { font-weight: 600; }\n.live-ticker-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--green-dark);\n  padding: 4px 8px;\n  border-radius: 6px;\n  transition: background .15s;\n}\n.live-ticker-link:hover { background: rgba(15, 110, 86, 0.08); }\n\n/* ─── KPI grid ────────────────────────────────────────────────────────────── */\n.kpi-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n}\n@media (max-width: 900px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }\n@media (max-width: 480px) { .kpi-grid { grid-template-columns: 1fr; } }\n\n/* ─── Card base ───────────────────────────────────────────────────────────── */\n.card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 20px;\n  box-shadow: var(--shadow-card);\n}\n\n.card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n.card-title {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--gray-900);\n}\n.card-subtitle {\n  font-size: 12px;\n  color: var(--gray-500);\n  margin-top: 2px;\n}\n\n/* ─── Segmented control ───────────────────────────────────────────────────── */\n.seg-control {\n  display: inline-flex;\n  background: var(--gray-100);\n  border-radius: 8px;\n  padding: 3px;\n}\n.seg-btn {\n  padding: 5px 12px;\n  font-size: 11.5px;\n  font-weight: 500;\n  color: var(--gray-500);\n  border-radius: 6px;\n  transition: background .15s, color .15s;\n}\n.seg-btn:hover { color: var(--gray-900); }\n.seg-btn.is-active {\n  background: var(--white);\n  color: var(--gray-900);\n  box-shadow: var(--shadow-sm);\n}\n\n/* ─── Charts ──────────────────────────────────────────────────────────────── */\n.grid-2col {\n  display: grid;\n  grid-template-columns: 1.5fr 1fr;\n  gap: 16px;\n}\n@media (max-width: 1100px) { .grid-2col { grid-template-columns: 1fr; } }\n\n.chart-card { display: flex; flex-direction: column; }\n.chart-wrap {\n  margin: 0 -8px;\n  min-height: 220px;\n}\n\n/* ─── Top items list ──────────────────────────────────────────────────────── */\n.top-items {\n  list-style: none;\n  display: flex;\n  flex-direction: column;\n}\n.top-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--gray-100);\n}\n.top-item:last-child { border-bottom: none; }\n.top-item-rank {\n  width: 26px;\n  height: 26px;\n  border-radius: 6px;\n  background: var(--green-light);\n  color: var(--green-darker);\n  font-size: 12px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.top-item-info { flex: 1; min-width: 0; }\n.top-item-name {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--gray-900);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.top-item-meta {\n  font-size: 11.5px;\n  color: var(--gray-500);\n  margin-top: 1px;\n}\n.top-item-change {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 11.5px;\n  font-weight: 600;\n  padding: 3px 8px;\n  border-radius: var(--radius-pill);\n  flex-shrink: 0;\n}\n.top-item-change.positive { color: var(--green-darker); background: var(--green-light); }\n.top-item-change.negative { color: var(--red);          background: var(--red-bg); }\n\n/* ─── Order list ──────────────────────────────────────────────────────────── */\n.order-list { display: flex; flex-direction: column; }\n\n/* ─── Quick actions ───────────────────────────────────────────────────────── */\n.grid-3col {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 14px;\n}\n@media (max-width: 900px) { .grid-3col { grid-template-columns: 1fr; } }\n\n.quick-action {\n  display: flex;\n  align-items: flex-start;\n  gap: 14px;\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 16px;\n  text-align: left;\n  transition: border-color .15s, transform .15s;\n  box-shadow: var(--shadow-card);\n}\n.quick-action:hover {\n  border-color: var(--green);\n  transform: translateY(-1px);\n}\n.quick-action-icon {\n  width: 38px;\n  height: 38px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.icon-green  { background: var(--green-light); color: var(--green-dark); }\n.icon-blue   { background: var(--blue-bg);     color: var(--blue); }\n.icon-purple { background: var(--purple-bg);   color: var(--purple); }\n.icon-amber  { background: var(--amber-bg);    color: var(--amber); }\n\n.quick-action-body { flex: 1; min-width: 0; }\n.quick-action-title {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--gray-900);\n  margin-bottom: 3px;\n}\n.quick-action-desc {\n  font-size: 12px;\n  color: var(--gray-500);\n  line-height: 1.45;\n}\n.quick-action-cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--green-dark);\n  margin-top: 8px;\n  white-space: nowrap;\n}\n\n/* ─── Tip card ────────────────────────────────────────────────────────────── */\n.tip-card {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  background: linear-gradient(135deg, #FFFBEB, #FEF3C7);\n  border: 1px solid #FDE68A;\n  border-radius: var(--radius-lg);\n  padding: 16px 18px;\n}\n.tip-card-icon {\n  width: 38px;\n  height: 38px;\n  border-radius: 10px;\n  background: var(--amber);\n  color: var(--white);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n.tip-card-body { flex: 1; min-width: 0; }\n.tip-card-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #78350F;\n  margin-bottom: 2px;\n}\n.tip-card-text {\n  font-size: 13px;\n  color: #92400E;\n  line-height: 1.55;\n}\n.tip-card-text strong { font-weight: 600; }\n\n@media (max-width: 600px) {\n  .tip-card { flex-direction: column; align-items: flex-start; text-align: left; }\n}\n\n.demo-notice {\n  background: #FEF3C7;\n  border: 1px solid #FCD34D;\n  border-radius: 8px;\n  padding: 10px 16px;\n  font-size: 13px;\n  color: #92400E;\n  margin-bottom: 16px;\n}\n.demo-notice a { color: #92400E; font-weight: 700; }\n.quick-actions { display: flex; gap: 10px; margin-top: 16px; }\n.qa-btn { display:flex;align-items:center;gap:6px;padding:10px 16px;border-radius:8px;border:1px solid #E5E7EB;background:#fff;cursor:pointer;font-size:13px;font-weight:600;color:#374151;transition:background .15s; }\n.qa-btn:hover { background: #F3F4F6; }\n.link-btn { display:flex;align-items:center;gap:4px;background:none;border:none;color:#1D9E75;font-size:13px;font-weight:600;cursor:pointer; }\n.card-header-row { display:flex;align-items:center;justify-content:space-between;margin-bottom:12px; }\n.empty-msg { text-align:center;color:#9CA3AF;padding:24px;font-size:14px; }\n"],["STYLE",{},"/* ─── Orders page ─────────────────────────────────────────────────────────── */\n.orders-page { display: flex; flex-direction: column; gap: 20px; }\n\n.live-dot {\n  display: inline-block;\n  width: 7px; height: 7px;\n  border-radius: 50%;\n  background: var(--green);\n  margin-left: 8px;\n  animation: ticker-pulse 2s infinite;\n  vertical-align: middle;\n}\n\n/* ─── Toolbar ─────────────────────────────────────────────────────────────── */\n.search-wrap { position: relative; display: flex; align-items: center; }\n.search-icon { position: absolute; left: 10px; color: var(--gray-400); pointer-events: none; }\n.search-input {\n  height: 38px;\n  width: 240px;\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  padding: 0 12px 0 32px;\n  font-size: 13px;\n  color: var(--gray-900);\n  background: var(--white);\n  transition: border-color .15s;\n}\n.search-input:focus { outline: none; border-color: var(--green); }\n\n.view-toggle { display: flex; border: 1px solid var(--gray-200); border-radius: var(--radius-md); overflow: hidden; }\n.view-btn {\n  height: 38px;\n  padding: 0 14px;\n  font-size: 12.5px;\n  font-weight: 500;\n  color: var(--gray-500);\n  background: var(--white);\n  transition: background .12s, color .12s;\n}\n.view-btn.active { background: var(--gray-900); color: var(--white); }\n\n.btn-icon-only { width: 38px; padding: 0; justify-content: center; }\n\n/* ─── Kanban board ────────────────────────────────────────────────────────── */\n.kanban-board {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 14px;\n  align-items: start;\n}\n\n.kanban-col {\n  border-radius: var(--radius-lg);\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  min-height: 200px;\n}\n.kanban-col-amber  { background: #FFFBF0; border: 1px solid #FDE68A; }\n.kanban-col-blue   { background: #EFF6FF; border: 1px solid #BFDBFE; }\n.kanban-col-green  { background: #F0FAF6; border: 1px solid #A7F3D0; }\n.kanban-col-gray   { background: var(--gray-50); border: 1px solid var(--gray-200); }\n\n.kanban-col-header {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--gray-700);\n  padding: 2px 0 6px;\n  border-bottom: 1px solid rgba(0,0,0,.06);\n}\n.kanban-col-amber  .kanban-col-header { color: var(--amber); }\n.kanban-col-blue   .kanban-col-header { color: var(--blue); }\n.kanban-col-green  .kanban-col-header { color: var(--green-darker); }\n.kanban-col-count {\n  margin-left: auto;\n  background: rgba(0,0,0,.08);\n  border-radius: var(--radius-pill);\n  font-size: 11px;\n  padding: 1px 7px;\n  font-weight: 700;\n}\n.kanban-empty { text-align: center; font-size: 12px; color: var(--gray-400); padding: 24px 0; }\n\n/* ─── Kanban card ─────────────────────────────────────────────────────────── */\n.kanban-card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  padding: 12px;\n  box-shadow: var(--shadow-card);\n  transition: box-shadow .15s, border-color .15s;\n}\n.kanban-card:hover { box-shadow: var(--shadow-md); border-color: var(--gray-300); }\n.kanban-card.is-expanded { border-color: var(--green); }\n\n.kc-top { cursor: pointer; }\n\n.kc-id-row {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  margin-bottom: 6px;\n}\n.kc-id { font-size: 12.5px; font-weight: 700; color: var(--gray-900); }\n.kc-time {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 11px;\n  color: var(--gray-400);\n  margin-left: auto;\n}\n\n.kc-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 5px; }\n.kc-table {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  font-size: 12px;\n  color: var(--gray-700);\n  font-weight: 500;\n}\n.kc-customer { font-size: 12px; color: var(--gray-500); }\n\n.kc-notes {\n  font-size: 11.5px;\n  color: var(--amber);\n  background: var(--amber-bg);\n  border-radius: 6px;\n  padding: 4px 8px;\n  margin-bottom: 6px;\n}\n\n.kc-summary { font-size: 12px; color: var(--gray-500); }\n.kc-summary strong { color: var(--gray-900); }\n\n.kc-items {\n  border-top: 1px solid var(--gray-100);\n  margin-top: 10px;\n  padding-top: 10px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.kc-item-row { display: flex; align-items: center; gap: 6px; font-size: 12px; }\n.kc-item-qty { width: 20px; color: var(--gray-400); font-weight: 600; }\n.kc-item-name { flex: 1; color: var(--gray-800); }\n.kc-item-price { color: var(--gray-600); font-weight: 600; }\n\n.kc-actions {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 10px;\n  padding-top: 10px;\n  border-top: 1px solid var(--gray-100);\n}\n.kc-action-icon {\n  width: 28px; height: 28px;\n  border-radius: 7px;\n  display: flex; align-items: center; justify-content: center;\n  color: var(--gray-400);\n  border: 1px solid var(--gray-200);\n  transition: background .12s, color .12s;\n}\n.kc-action-icon:hover { background: var(--gray-100); color: var(--gray-700); }\n.kc-action-primary {\n  margin-left: auto;\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  height: 28px;\n  padding: 0 11px;\n  border-radius: 7px;\n  font-size: 11.5px;\n  font-weight: 600;\n  background: var(--gray-900);\n  color: var(--white);\n  transition: background .12s;\n}\n.kc-action-primary:hover { background: var(--gray-700); }\n.kc-action-reject {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  height: 28px;\n  padding: 0 10px;\n  border-radius: 7px;\n  font-size: 11.5px;\n  font-weight: 600;\n  background: var(--red-bg);\n  color: var(--red);\n  transition: background .12s;\n}\n.kc-action-reject:hover { background: #FECACA; }\n\n/* Payment badges */\n.pay-badge {\n  display: inline-flex;\n  align-items: center;\n  font-size: 10.5px;\n  font-weight: 600;\n  padding: 2px 7px;\n  border-radius: var(--radius-pill);\n}\n.pay-online { background: var(--blue-bg); color: var(--blue); }\n.pay-cash   { background: var(--green-light); color: var(--green-darker); }\n\n/* ─── List view table ─────────────────────────────────────────────────────── */\n.orders-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 13px;\n}\n.orders-table th {\n  text-align: left;\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--gray-400);\n  text-transform: uppercase;\n  letter-spacing: .05em;\n  padding: 0 12px 12px;\n  border-bottom: 1px solid var(--gray-100);\n}\n.orders-table td { padding: 12px; border-bottom: 1px solid var(--gray-100); vertical-align: top; }\n.orders-table tr:last-child td { border-bottom: none; }\n.orders-table tr:hover td { background: var(--gray-50); }\n.list-order-id { font-weight: 700; color: var(--gray-900); }\n.list-time { font-size: 11px; color: var(--gray-400); margin-top: 2px; }\n.list-phone { font-size: 11.5px; color: var(--gray-500); }\n.list-item-line { font-size: 12px; color: var(--gray-600); line-height: 1.7; }\n.list-amount { font-weight: 700; font-variant-numeric: tabular-nums; }\n.list-actions { display: flex; gap: 6px; align-items: center; }\n\n.order-status-pill {\n  display: inline-flex;\n  align-items: center;\n  font-size: 11px;\n  font-weight: 600;\n  padding: 3px 9px;\n  border-radius: var(--radius-pill);\n}\n.status-new       { background: var(--amber-bg);    color: var(--amber); }\n.status-preparing { background: var(--blue-bg);      color: var(--blue); }\n.status-ready     { background: var(--green-light);  color: var(--green-darker); }\n.status-served    { background: var(--gray-100);     color: var(--gray-600); }\n.status-rejected  { background: var(--red-bg);       color: var(--red); }\n\n.btn-sm { height: 30px; padding: 0 12px; font-size: 12px; border-radius: 8px; display: inline-flex; align-items: center; }\n.btn-danger { background: var(--red-bg); color: var(--red); font-weight: 600; }\n.btn-danger:hover { background: #FECACA; }\n\n/* ─── Responsive ──────────────────────────────────────────────────────────── */\n@media (max-width: 900px) {\n  .kanban-board { grid-template-columns: repeat(2, 1fr); }\n}\n@media (max-width: 600px) {\n  .kanban-board { grid-template-columns: 1fr; }\n  .search-input { width: 160px; }\n}\n\n.demo-notice { background:#FEF3C7;border:1px solid #FCD34D;border-radius:8px;padding:10px 16px;font-size:13px;color:#92400E;margin-bottom:16px; }\n.orders-controls { display:flex;gap:10px;margin-bottom:12px; }\n.search-input { flex:1;height:40px;border:1px solid #E5E7EB;border-radius:8px;padding:0 14px;font-size:14px; }\n.icon-btn { width:40px;height:40px;border:1px solid #E5E7EB;border-radius:8px;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center; }\n.filter-chips { display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:16px; }\n.chip { height:32px;padding:0 12px;border-radius:999px;border:1px solid #E5E7EB;background:#fff;font-size:12px;font-weight:600;color:#6B7280;cursor:pointer;white-space:nowrap; }\n.chip.active { background:#111827;border-color:#111827;color:#fff; }\n.chip-count { margin-left:4px;opacity:0.6; }\n.orders-list-full { display:flex;flex-direction:column;gap:10px; }\n.order-card { background:#fff;border:1px solid #E5E7EB;border-radius:12px;padding:16px; }\n.order-card-top { display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px; }\n.order-num { font-size:15px;font-weight:800;color:#111827;margin-right:8px; }\n.order-customer { font-size:13px;color:#6B7280; }\n.order-table { font-size:11px;background:#F3F4F6;border-radius:4px;padding:2px 6px;margin-left:6px;color:#374151; }\n.status-pill { font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px; }\n.order-items-list { display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px; }\n.order-item-tag { font-size:12px;background:#F3F4F6;border-radius:4px;padding:3px 8px;color:#374151; }\n.order-card-footer { display:flex;align-items:center;gap:10px; }\n.order-time { font-size:12px;color:#9CA3AF;flex:1; }\n.order-amt { font-size:15px;font-weight:800;color:#111827; }\n.advance-btn { background:#1D9E75;color:#fff;border:none;border-radius:8px;padding:6px 14px;font-size:12px;font-weight:700;cursor:pointer; }\n.empty-state { text-align:center;color:#9CA3AF;padding:48px;font-size:14px; }\n"],["STYLE",{},".menu-page { display: flex; flex-direction: column; gap: 20px; }\n\n.warn-text {\n  color: var(--amber);\n  font-weight: 600;\n  margin-right: 10px;\n}\n\n/* OCR Banner */\n.ocr-banner {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  background: var(--blue-bg);\n  border: 1px solid #BFDBFE;\n  border-radius: var(--radius-md);\n  padding: 14px 18px;\n}\n.ocr-banner-icon { color: var(--blue); flex-shrink: 0; }\n.ocr-banner-body { flex: 1; }\n.ocr-banner-title { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.ocr-banner-sub { font-size: 12px; color: var(--gray-500); margin-top: 2px; }\n.ocr-banner-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }\n\n/* Search row */\n.menu-search-row { display: flex; align-items: center; gap: 12px; }\n.search-wrap { position: relative; display: flex; align-items: center; }\n.search-icon { position: absolute; left: 10px; color: var(--gray-400); pointer-events: none; }\n.search-input {\n  height: 38px;\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  padding: 0 12px 0 32px;\n  font-size: 13px;\n  color: var(--gray-900);\n  background: var(--white);\n  transition: border-color .15s;\n}\n.search-input:focus { outline: none; border-color: var(--green); }\n\n.upload-toggle { display: flex; border: 1px solid var(--gray-200); border-radius: var(--radius-md); overflow: hidden; margin-left: auto; }\n.upload-btn {\n  display: inline-flex; align-items: center; gap: 6px;\n  height: 38px; padding: 0 14px;\n  font-size: 12.5px; font-weight: 500; color: var(--gray-500);\n  background: var(--white); transition: background .12s, color .12s;\n}\n.upload-btn.active { background: var(--blue-bg); color: var(--blue); }\n.upload-btn:hover { background: var(--gray-50); }\n\n/* Categories */\n.categories-list { display: flex; flex-direction: column; gap: 10px; }\n\n.category-block {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  box-shadow: var(--shadow-card);\n}\n\n.category-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 18px;\n  cursor: pointer;\n  transition: background .12s;\n}\n.category-header:hover { background: var(--gray-50); }\n.cat-left { display: flex; align-items: center; gap: 10px; }\n.cat-icon { font-size: 18px; }\n.cat-name { font-size: 15px; font-weight: 600; color: var(--gray-900); }\n.cat-count {\n  font-size: 11.5px;\n  font-weight: 600;\n  background: var(--gray-100);\n  color: var(--gray-500);\n  padding: 2px 8px;\n  border-radius: var(--radius-pill);\n}\n.cat-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--gray-400);\n}\n.cat-action {\n  width: 30px; height: 30px;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 7px;\n  color: var(--gray-400);\n  transition: background .12s, color .12s;\n}\n.cat-action:hover { background: var(--gray-100); color: var(--gray-700); }\n.cat-add {\n  display: inline-flex; align-items: center; gap: 4px;\n  height: 30px; padding: 0 12px;\n  border-radius: 8px;\n  font-size: 12px; font-weight: 600;\n  background: var(--green-light); color: var(--green-darker);\n  transition: background .12s;\n}\n.cat-add:hover { background: #BDE8D6; }\n\n/* Items table */\n.items-table { border-top: 1px solid var(--gray-100); }\n.items-empty {\n  padding: 24px 18px;\n  font-size: 13px;\n  color: var(--gray-400);\n  text-align: center;\n}\n\n.item-row {\n  display: grid;\n  grid-template-columns: 24px 44px 1fr 70px 44px auto;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--gray-100);\n  transition: background .12s;\n}\n.item-row:last-child { border-bottom: none; }\n.item-row:hover { background: var(--gray-50); }\n.item-row.item-unavailable { opacity: 0.55; }\n\n.item-drag { color: var(--gray-300); cursor: grab; }\n.item-drag:active { cursor: grabbing; }\n\n.item-img-placeholder {\n  width: 40px; height: 40px;\n  border-radius: 8px;\n  display: flex; align-items: center; justify-content: center;\n}\n.has-img { background: var(--green-light); color: var(--green-dark); }\n.no-img  { background: var(--gray-100);   color: var(--gray-300);  border: 1px dashed var(--gray-300); }\n\n.item-info { min-width: 0; }\n.item-name-row { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; margin-bottom: 3px; }\n.item-name { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.item-tag {\n  font-size: 10.5px; font-weight: 600;\n  padding: 2px 7px; border-radius: var(--radius-pill);\n}\n.tag-bestseller { background: var(--amber-bg); color: var(--amber); }\n.tag-spicy      { background: var(--red-bg);   color: var(--red); }\n.tag-veg        { background: var(--green-light); color: var(--green-darker); }\n.item-off-badge { font-size: 10.5px; font-weight: 600; background: var(--gray-100); color: var(--gray-500); padding: 2px 7px; border-radius: var(--radius-pill); }\n.item-desc { font-size: 12px; color: var(--gray-400); line-height: 1.4; }\n\n.item-price { font-size: 14px; font-weight: 700; color: var(--gray-900); font-variant-numeric: tabular-nums; }\n\n.toggle-btn { display: flex; align-items: center; transition: color .15s; }\n.toggle-on  { color: var(--green); }\n.toggle-off { color: var(--gray-300); }\n\n.item-actions { display: flex; gap: 4px; }\n.item-action-btn {\n  width: 30px; height: 30px;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 7px;\n  color: var(--gray-400);\n  transition: background .12s, color .12s;\n}\n.item-action-btn:hover { background: var(--gray-100); color: var(--gray-700); }\n.item-action-delete:hover { background: var(--red-bg); color: var(--red); }\n\n/* Add category */\n.add-cat-row {\n  display: flex; gap: 8px; align-items: center;\n  padding: 14px 18px;\n  background: var(--white);\n  border: 1px solid var(--green);\n  border-radius: var(--radius-lg);\n}\n.add-cat-input {\n  flex: 1; height: 38px;\n  border: 1px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 0 12px; font-size: 13px;\n  transition: border-color .15s;\n}\n.add-cat-input:focus { outline: none; border-color: var(--green); }\n\n.add-cat-trigger {\n  display: inline-flex; align-items: center; gap: 7px;\n  padding: 12px 18px;\n  border: 1.5px dashed var(--gray-200);\n  border-radius: var(--radius-lg);\n  font-size: 13px; font-weight: 500;\n  color: var(--gray-400);\n  background: var(--white);\n  transition: border-color .15s, color .15s;\n  width: 100%;\n  justify-content: center;\n}\n.add-cat-trigger:hover { border-color: var(--green); color: var(--green-dark); }\n\n.btn-sm { height: 30px; padding: 0 12px; font-size: 12px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; }\n.btn-link { background: none; color: var(--green-dark); font-weight: 500; padding: 0; }\n.btn-link:hover { color: var(--green); }\n\n/* ─── Modal ───────────────────────────────────────────────────────────────── */\n.modal-backdrop {\n  position: fixed; inset: 0;\n  background: rgba(0,0,0,.35);\n  display: flex; align-items: center; justify-content: center;\n  z-index: 200;\n  padding: 16px;\n}\n.modal {\n  background: var(--white);\n  border-radius: var(--radius-xl);\n  width: 100%;\n  max-width: 480px;\n  box-shadow: var(--shadow-lg);\n  display: flex; flex-direction: column;\n  max-height: 90vh;\n  overflow: hidden;\n}\n.modal-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 20px 24px 16px;\n  border-bottom: 1px solid var(--gray-100);\n}\n.modal-title { font-size: 17px; font-weight: 700; }\n.modal-close {\n  width: 32px; height: 32px;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 8px; color: var(--gray-400);\n  transition: background .12s;\n}\n.modal-close:hover { background: var(--gray-100); color: var(--gray-700); }\n\n.modal-body { padding: 20px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }\n.modal-footer {\n  display: flex; gap: 10px; justify-content: flex-end;\n  padding: 16px 24px;\n  border-top: 1px solid var(--gray-100);\n}\n\n.form-field { display: flex; flex-direction: column; gap: 6px; }\n.form-label { font-size: 12.5px; font-weight: 600; color: var(--gray-700); }\n.form-input {\n  height: 40px;\n  border: 1px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 0 12px; font-size: 13.5px;\n  color: var(--gray-900); background: var(--white);\n  transition: border-color .15s;\n}\n.form-input:focus { outline: none; border-color: var(--green); }\n.form-textarea { height: auto; padding: 10px 12px; resize: vertical; }\n.form-select { appearance: none; }\n.form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n\n.photo-upload-area {\n  border: 1.5px dashed var(--gray-200);\n  border-radius: var(--radius-md);\n  padding: 24px;\n  display: flex; flex-direction: column; align-items: center; gap: 6px;\n  cursor: pointer; transition: border-color .15s;\n}\n.photo-upload-area:hover { border-color: var(--green); }\n.photo-upload-text { font-size: 13px; color: var(--gray-600); }\n.photo-upload-sub { font-size: 11.5px; color: var(--gray-400); }\n\n.form-avail-row {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 10px 0;\n}\n\n.form-error {\n  display: flex; align-items: center; gap: 6px;\n  font-size: 12px; color: var(--red);\n}\n\n.btn[disabled] { opacity: 0.45; cursor: not-allowed; }\n\n@media (max-width: 700px) {\n  .item-row { grid-template-columns: 44px 1fr 60px 44px auto; }\n  .item-drag { display: none; }\n}\n"],["STYLE",{},".qr-page { display: flex; flex-direction: column; gap: 20px; }\n\n.qr-info-bar {\n  display: flex; align-items: center; gap: 10px;\n  background: var(--green-light);\n  border: 1px solid #A7F3D0;\n  border-radius: var(--radius-md);\n  padding: 11px 16px;\n  font-size: 13px;\n  color: var(--green-darker);\n}\n.qr-info-bar strong { font-weight: 700; }\n\n.qr-layout {\n  display: grid;\n  grid-template-columns: 280px 1fr;\n  gap: 16px;\n  align-items: start;\n}\n\n/* ─── List panel ──────────────────────────────────────────────────────────── */\n.qr-list-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.qr-list-item {\n  display: flex; align-items: center; gap: 12px;\n  padding: 12px 14px;\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  text-align: left;\n  transition: border-color .15s, box-shadow .15s;\n  cursor: pointer;\n}\n.qr-list-item:hover { border-color: var(--gray-300); box-shadow: var(--shadow-sm); }\n.qr-list-item.is-selected { border-color: var(--green); background: var(--green-light); }\n\n.qr-list-thumb {\n  flex-shrink: 0;\n  border-radius: 6px;\n  overflow: hidden;\n  border: 1px solid var(--gray-200);\n}\n\n.qr-list-info { flex: 1; min-width: 0; }\n.qr-list-name { font-size: 13.5px; font-weight: 600; color: var(--gray-900); margin-bottom: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.qr-list-meta { display: flex; align-items: center; gap: 8px; }\n\n.qr-type-badge {\n  font-size: 10.5px; font-weight: 600;\n  padding: 2px 7px; border-radius: var(--radius-pill);\n  text-transform: capitalize;\n}\n.qr-type-green  { background: var(--green-light);  color: var(--green-darker); }\n.qr-type-blue   { background: var(--blue-bg);      color: var(--blue); }\n.qr-type-purple { background: var(--purple-bg);    color: var(--purple); }\n\n.qr-scan-count {\n  display: inline-flex; align-items: center; gap: 3px;\n  font-size: 11px; color: var(--gray-400);\n}\n\n/* Create form */\n.qr-create-form {\n  background: var(--white);\n  border: 1.5px dashed var(--green);\n  border-radius: var(--radius-md);\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.form-field { display: flex; flex-direction: column; gap: 5px; }\n.form-label { font-size: 12px; font-weight: 600; color: var(--gray-600); }\n.form-input {\n  height: 38px;\n  border: 1px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 0 12px; font-size: 13px; color: var(--gray-900);\n  transition: border-color .15s;\n}\n.form-input:focus { outline: none; border-color: var(--green); }\n\n.qr-type-selector { display: flex; flex-direction: column; gap: 6px; }\n.qr-type-opt {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 8px 10px;\n  border: 1px solid var(--gray-200); border-radius: 8px;\n  text-align: left;\n  transition: border-color .12s, background .12s;\n}\n.qr-type-opt:hover { border-color: var(--green); }\n.qr-type-opt.is-selected { border-color: var(--green); background: var(--green-light); }\n.qr-type-opt-label { font-size: 12.5px; font-weight: 600; color: var(--gray-900); }\n.qr-type-opt-desc { font-size: 11px; color: var(--gray-400); }\n\n/* ─── Detail panel ────────────────────────────────────────────────────────── */\n.qr-detail-panel {\n  display: flex; flex-direction: column; gap: 20px;\n}\n.qr-detail-header {\n  display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;\n}\n.qr-detail-name { font-size: 18px; font-weight: 700; color: var(--gray-900); margin-bottom: 6px; }\n\n/* QR display */\n.qr-display-area {\n  display: flex; justify-content: center;\n  background: var(--gray-50);\n  border: 1px solid var(--gray-100);\n  border-radius: var(--radius-lg);\n  padding: 32px 24px;\n}\n.qr-display-inner {\n  display: flex; flex-direction: column; align-items: center; gap: 12px;\n  background: white;\n  border-radius: 12px;\n  padding: 24px;\n  box-shadow: 0 2px 12px rgba(0,0,0,.08);\n}\n.qr-shop-name {\n  font-size: 16px; font-weight: 800;\n  letter-spacing: -.01em;\n  color: var(--gray-900);\n}\n.qr-scan-hint {\n  display: flex; align-items: center; gap: 5px;\n  font-size: 12px; color: var(--gray-400);\n}\n.qr-label-below {\n  font-size: 11.5px; font-weight: 600;\n  color: var(--gray-600);\n  background: var(--gray-100);\n  padding: 4px 12px;\n  border-radius: var(--radius-pill);\n}\n\n/* URL row */\n.qr-url-row {\n  display: flex; align-items: center; gap: 10px;\n  background: var(--gray-50);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  padding: 10px 14px;\n  font-size: 12.5px;\n}\n.qr-url-text {\n  flex: 1;\n  color: var(--gray-600);\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n  font-family: 'Courier New', monospace;\n  font-size: 12px;\n}\n.qr-copy-btn {\n  display: inline-flex; align-items: center; gap: 4px;\n  height: 28px; padding: 0 10px;\n  border-radius: 7px;\n  font-size: 12px; font-weight: 600;\n  background: var(--white); color: var(--gray-700);\n  border: 1px solid var(--gray-200);\n  flex-shrink: 0;\n  transition: background .12s, color .12s;\n}\n.qr-copy-btn:hover { background: var(--green-light); color: var(--green-darker); }\n\n/* Stats grid */\n.qr-stats-grid {\n  display: grid; grid-template-columns: repeat(4, 1fr);\n  gap: 1px;\n  background: var(--gray-100);\n  border: 1px solid var(--gray-100);\n  border-radius: var(--radius-md);\n  overflow: hidden;\n}\n.qr-stat {\n  background: var(--white);\n  padding: 14px;\n  text-align: center;\n}\n.qr-stat-value { font-size: 18px; font-weight: 700; color: var(--gray-900); }\n.qr-stat-label { font-size: 11px; color: var(--gray-400); margin-top: 3px; }\n\n/* Action row */\n.qr-action-row { display: flex; gap: 8px; flex-wrap: wrap; }\n.qr-dl-btn {\n  display: inline-flex; align-items: center; gap: 6px;\n  height: 38px; padding: 0 16px;\n  border-radius: var(--radius-md);\n  font-size: 13px; font-weight: 500;\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  color: var(--gray-700);\n  transition: border-color .15s, background .15s;\n}\n.qr-dl-btn:hover { border-color: var(--gray-400); background: var(--gray-50); }\n\n.btn-icon-only { width: 38px; padding: 0; justify-content: center; }\n.btn-danger-subtle {\n  display: inline-flex; align-items: center; gap: 6px;\n  height: 38px; padding: 0 16px;\n  border-radius: var(--radius-md);\n  font-size: 13px; font-weight: 500;\n  background: var(--red-bg); color: var(--red);\n  transition: background .15s;\n}\n.btn-danger-subtle:hover { background: #FECACA; }\n\n.card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 24px;\n  box-shadow: var(--shadow-card);\n}\n\n@media (max-width: 800px) {\n  .qr-layout { grid-template-columns: 1fr; }\n  .qr-stats-grid { grid-template-columns: repeat(2, 1fr); }\n}\n"],["STYLE",{},".staff-page { display: flex; flex-direction: column; gap: 20px; }\n\n.staff-layout { display: grid; grid-template-columns: 1fr 320px; gap: 16px; align-items: start; }\n\n.staff-list-col { display: flex; flex-direction: column; gap: 16px; }\n\n/* Staff table */\n.card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 20px;\n  box-shadow: var(--shadow-card);\n}\n.card-header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }\n.card-section-title { font-size: 15px; font-weight: 700; color: var(--gray-900); }\n\n.staff-table-header {\n  display: grid;\n  grid-template-columns: 1fr 130px 130px 160px;\n  padding: 0 0 10px;\n  border-bottom: 1px solid var(--gray-100);\n  font-size: 11px;\n  font-weight: 600;\n  color: var(--gray-400);\n  text-transform: uppercase;\n  letter-spacing: .05em;\n  margin-bottom: 4px;\n}\n\n.staff-row {\n  display: grid;\n  grid-template-columns: 1fr 130px 130px 160px;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--gray-100);\n  transition: background .12s;\n}\n.staff-row:last-child { border-bottom: none; }\n.staff-row:hover { background: var(--gray-50); margin: 0 -20px; padding-left: 20px; padding-right: 20px; border-radius: 8px; }\n.staff-row.staff-inactive { opacity: 0.55; }\n\n.staff-identity { display: flex; align-items: center; gap: 12px; }\n.staff-avatar {\n  width: 38px; height: 38px;\n  border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 12.5px; font-weight: 700;\n  flex-shrink: 0;\n}\n.avatar-green  { background: var(--green-light);  color: var(--green-darker); }\n.avatar-blue   { background: var(--blue-bg);      color: var(--blue); }\n.avatar-purple { background: var(--purple-bg);    color: var(--purple); }\n.avatar-amber  { background: var(--amber-bg);     color: var(--amber); }\n\n.staff-name { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.staff-phone {\n  display: inline-flex; align-items: center; gap: 3px;\n  font-size: 11.5px; color: var(--gray-400); margin-top: 2px;\n}\n\n/* Role badges */\n.role-badge {\n  display: inline-flex; align-items: center;\n  font-size: 11px; font-weight: 600;\n  padding: 3px 9px; border-radius: var(--radius-pill);\n}\n.role-purple { background: var(--purple-bg);    color: var(--purple); }\n.role-blue   { background: var(--blue-bg);      color: var(--blue); }\n.role-green  { background: var(--green-light);  color: var(--green-darker); }\n.role-amber  { background: var(--amber-bg);     color: var(--amber); }\n.role-gray   { background: var(--gray-100);     color: var(--gray-600); }\n\n.staff-status-col { display: flex; flex-direction: column; gap: 2px; }\n.online-dot-wrap {\n  display: inline-flex; align-items: center; gap: 5px;\n  font-size: 12.5px; font-weight: 600; color: var(--green-darker);\n}\n.online-dot {\n  width: 7px; height: 7px;\n  border-radius: 50%; background: var(--green);\n  animation: ticker-pulse 2s infinite;\n}\n.offline-text { font-size: 12.5px; color: var(--gray-400); }\n.last-active { font-size: 11px; color: var(--gray-400); }\n\n.staff-row-actions { display: flex; align-items: center; gap: 6px; }\n.staff-toggle {\n  height: 26px; padding: 0 10px;\n  border-radius: 6px; font-size: 11px; font-weight: 600;\n  transition: background .12s;\n}\n.tog-on  { background: var(--green-light); color: var(--green-darker); }\n.tog-off { background: var(--gray-100);    color: var(--gray-500); }\n.staff-action-btn {\n  width: 28px; height: 28px;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 7px; color: var(--gray-400);\n  transition: background .12s, color .12s;\n}\n.staff-action-btn:hover { background: var(--gray-100); color: var(--gray-700); }\n.staff-action-delete:hover { background: var(--red-bg); color: var(--red); }\n.staff-empty { text-align: center; padding: 32px; font-size: 13px; color: var(--gray-400); }\n\n/* Add staff */\n.add-staff-card { display: flex; flex-direction: column; gap: 0; }\n.add-staff-form { display: flex; flex-direction: column; gap: 14px; }\n.form-field { display: flex; flex-direction: column; gap: 5px; }\n.form-label { font-size: 12px; font-weight: 600; color: var(--gray-600); }\n.form-input {\n  height: 40px;\n  border: 1px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 0 12px; font-size: 13px; color: var(--gray-900);\n  transition: border-color .15s;\n}\n.form-input:focus { outline: none; border-color: var(--green); }\n.form-select { appearance: none; cursor: pointer; }\n\n.otp-notice {\n  display: flex; align-items: center; gap: 8px;\n  font-size: 12px; color: var(--blue);\n  background: var(--blue-bg);\n  border-radius: 8px; padding: 10px 12px;\n}\n\n/* Roles sidebar */\n.roles-col {}\n.role-block {\n  border-bottom: 1px solid var(--gray-100);\n  padding: 14px 0;\n}\n.role-block:first-of-type { padding-top: 0; }\n.role-block:last-child { border-bottom: none; padding-bottom: 0; }\n.role-block-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 5px; }\n.role-count { font-size: 11px; color: var(--gray-400); }\n.role-desc { font-size: 12px; color: var(--gray-500); margin-bottom: 8px; }\n.role-perms { display: flex; flex-direction: column; gap: 3px; }\n.perm-item {\n  display: flex; align-items: center; gap: 6px;\n  font-size: 11.5px;\n}\n.perm-on  { color: var(--green-darker); }\n.perm-off { color: var(--gray-300); }\n\n/* Search */\n.search-wrap { position: relative; display: flex; align-items: center; }\n.search-icon { position: absolute; left: 10px; color: var(--gray-400); pointer-events: none; }\n.search-input {\n  height: 38px;\n  border: 1px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 0 12px 0 32px; font-size: 13px; color: var(--gray-900);\n  background: var(--white); transition: border-color .15s;\n}\n.search-input:focus { outline: none; border-color: var(--green); }\n\n/* Modal */\n.modal-backdrop {\n  position: fixed; inset: 0;\n  background: rgba(0,0,0,.35);\n  display: flex; align-items: center; justify-content: center;\n  z-index: 200; padding: 16px;\n}\n.modal {\n  background: var(--white); border-radius: var(--radius-xl);\n  width: 100%; max-width: 420px;\n  box-shadow: var(--shadow-lg);\n  display: flex; flex-direction: column;\n}\n.modal-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 20px 24px 16px;\n  border-bottom: 1px solid var(--gray-100);\n}\n.modal-title { font-size: 16px; font-weight: 700; }\n.modal-close {\n  width: 32px; height: 32px;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 8px; color: var(--gray-400);\n  transition: background .12s;\n}\n.modal-close:hover { background: var(--gray-100); color: var(--gray-700); }\n.modal-body { padding: 20px 24px; display: flex; flex-direction: column; gap: 14px; }\n.modal-footer { display: flex; gap: 10px; justify-content: flex-end; padding: 16px 24px; border-top: 1px solid var(--gray-100); }\n\n@media (max-width: 900px) {\n  .staff-layout { grid-template-columns: 1fr; }\n  .staff-table-header,\n  .staff-row { grid-template-columns: 1fr auto; }\n  .staff-table-header span:not(:first-child) { display: none; }\n}\n"],["STYLE",{},".reports-page { display: flex; flex-direction: column; gap: 20px; }\n\n/* Range tabs */\n.range-tabs { display: flex; border: 1px solid var(--gray-200); border-radius: var(--radius-md); overflow: hidden; }\n.range-tab {\n  height: 38px; padding: 0 14px;\n  font-size: 12.5px; font-weight: 500;\n  color: var(--gray-500); background: var(--white);\n  transition: background .12s, color .12s;\n  white-space: nowrap;\n}\n.range-tab.active { background: var(--gray-900); color: var(--white); }\n\n/* KPI grid */\n.kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }\n\n/* Cards */\n.card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 24px;\n  box-shadow: var(--shadow-card);\n}\n.chart-section { padding: 20px 24px; }\n.card-header {\n  display: flex; align-items: flex-start; justify-content: space-between;\n  gap: 12px; margin-bottom: 16px;\n}\n.card-title { font-size: 15px; font-weight: 700; color: var(--gray-900); }\n.card-subtitle { font-size: 12px; color: var(--gray-400); margin-top: 3px; }\n\n.grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n\n/* Peak note */\n.peak-note {\n  margin-top: 12px;\n  font-size: 12.5px; color: var(--gray-600);\n  background: var(--amber-bg);\n  border-radius: 8px;\n  padding: 8px 12px;\n}\n.peak-note strong { color: var(--amber); }\n\n/* Pie */\n.pie-layout { display: flex; align-items: center; gap: 8px; }\n.pie-legend { display: flex; flex-direction: column; gap: 8px; flex: 1; }\n.pie-legend-item { display: flex; align-items: center; gap: 7px; font-size: 12.5px; }\n.pie-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }\n.pie-legend-name { flex: 1; color: var(--gray-700); }\n.pie-legend-pct { font-weight: 700; color: var(--gray-900); }\n\n/* Payment split */\n.payment-split { border-top: 1px solid var(--gray-100); padding-top: 14px; margin-top: 4px; }\n.payment-split-title { font-size: 12.5px; font-weight: 600; color: var(--gray-700); margin-bottom: 8px; }\n.payment-bar-wrap { display: flex; height: 8px; border-radius: var(--radius-pill); overflow: hidden; margin-bottom: 10px; gap: 2px; }\n.payment-bar-seg { height: 100%; border-radius: var(--radius-pill); }\n.payment-split-legend { display: flex; gap: 16px; }\n\n/* Report table */\n.report-table { width: 100%; border-collapse: collapse; font-size: 13px; }\n.report-table th {\n  text-align: left;\n  font-size: 11px; font-weight: 600; color: var(--gray-400);\n  text-transform: uppercase; letter-spacing: .05em;\n  padding: 0 12px 12px;\n  border-bottom: 1px solid var(--gray-100);\n}\n.report-table td { padding: 12px; border-bottom: 1px solid var(--gray-100); }\n.report-table tr:last-child td { border-bottom: none; }\n.report-table tr:hover td { background: var(--gray-50); }\n\n.rank-cell { font-weight: 700; color: var(--gray-400); width: 32px; }\n.item-name-cell { font-weight: 600; color: var(--gray-900); }\n.cat-pill { font-size: 11px; font-weight: 600; background: var(--gray-100); color: var(--gray-600); padding: 3px 9px; border-radius: var(--radius-pill); }\n.num-cell { font-variant-numeric: tabular-nums; color: var(--gray-700); }\n.rev-cell { font-weight: 700; color: var(--gray-900); }\n\n.margin-bar-wrap { display: flex; align-items: center; gap: 8px; }\n.margin-bar { height: 6px; background: var(--green); border-radius: 3px; min-width: 6px; }\n.margin-pct { font-size: 12px; font-weight: 600; color: var(--green-darker); white-space: nowrap; }\n\n@media (max-width: 900px) {\n  .kpi-grid { grid-template-columns: repeat(2, 1fr); }\n  .grid-2col { grid-template-columns: 1fr; }\n}\n@media (max-width: 600px) {\n  .kpi-grid { grid-template-columns: 1fr 1fr; }\n  .range-tabs { display: none; }\n}\n"],["STYLE",{},".settings-page { display: flex; flex-direction: column; gap: 20px; }\n\n.btn-saved { background: var(--green); color: var(--white); display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: var(--radius-md); font-size: 13px; font-weight: 500; }\n\n.settings-layout { display: grid; grid-template-columns: 220px 1fr; gap: 16px; align-items: start; }\n\n/* Nav */\n.settings-nav {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 8px;\n  box-shadow: var(--shadow-card);\n  display: flex; flex-direction: column; gap: 2px;\n}\n.settings-nav-item {\n  display: flex; align-items: center; gap: 10px;\n  padding: 10px 12px;\n  border-radius: var(--radius-md);\n  font-size: 13.5px; font-weight: 500;\n  color: var(--gray-600);\n  text-align: left;\n  transition: background .12s, color .12s;\n}\n.settings-nav-item:hover { background: var(--gray-50); color: var(--gray-900); }\n.settings-nav-item.is-active { background: var(--gray-900); color: var(--white); }\n.settings-nav-item.is-active .settings-nav-arrow { opacity: 1; }\n.settings-nav-arrow { margin-left: auto; opacity: 0.3; }\n\n/* Settings card */\n.settings-card {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 24px;\n  box-shadow: var(--shadow-card);\n  display: flex; flex-direction: column; gap: 20px;\n}\n.settings-section-title { font-size: 17px; font-weight: 700; color: var(--gray-900); }\n.settings-section-sub { font-size: 13px; color: var(--gray-500); margin-top: -14px; }\n\n/* Logo upload */\n.logo-upload-row { display: flex; align-items: center; gap: 16px; }\n.logo-preview {\n  width: 64px; height: 64px;\n  border-radius: 14px;\n  background: var(--green-light);\n  color: var(--green-darker);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 20px; font-weight: 800;\n  border: 1px solid var(--gray-200);\n  flex-shrink: 0;\n}\n.logo-upload-label { font-size: 13px; font-weight: 600; color: var(--gray-900); }\n.logo-upload-hint { font-size: 12px; color: var(--gray-400); margin-top: 2px; }\n\n/* Form */\n.settings-form { display: flex; flex-direction: column; gap: 14px; }\n.form-field { display: flex; flex-direction: column; gap: 5px; }\n.form-label { font-size: 12px; font-weight: 600; color: var(--gray-700); }\n.form-input-wrap { position: relative; }\n.form-input-wrap.has-icon .form-input { padding-left: 34px; }\n.form-input-icon {\n  position: absolute; left: 10px; top: 50%; transform: translateY(-50%);\n  color: var(--gray-400); pointer-events: none;\n}\n.form-input {\n  width: 100%; height: 40px;\n  border: 1px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 0 12px; font-size: 13.5px; color: var(--gray-900);\n  background: var(--white); transition: border-color .15s;\n}\n.form-input:focus { outline: none; border-color: var(--green); }\n.form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n\n/* Tip */\n.settings-tip {\n  display: flex; align-items: center; gap: 8px;\n  font-size: 12.5px; color: var(--gray-500);\n  background: var(--gray-50);\n  border: 1px solid var(--gray-100);\n  border-radius: 8px; padding: 10px 12px;\n}\n.settings-tip strong { color: var(--gray-900); font-weight: 600; }\n\n/* Hours */\n.hours-list { display: flex; flex-direction: column; gap: 2px; }\n.hours-row {\n  display: grid;\n  grid-template-columns: 110px 44px 1fr;\n  align-items: center;\n  gap: 14px;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--gray-100);\n}\n.hours-row:last-child { border-bottom: none; }\n.hours-row.hours-closed { opacity: 0.55; }\n.hours-day { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.hours-time-row { display: flex; align-items: center; gap: 8px; }\n.time-input {\n  height: 36px; padding: 0 10px;\n  border: 1px solid var(--gray-200); border-radius: 8px;\n  font-size: 13px; color: var(--gray-900);\n  font-family: 'Courier New', monospace;\n  transition: border-color .15s;\n}\n.time-input:focus { outline: none; border-color: var(--green); }\n.hours-to { font-size: 12px; color: var(--gray-400); }\n.hours-closed-label { font-size: 13px; color: var(--gray-400); font-style: italic; }\n\n/* Toggle */\n.toggle-btn { display: flex; align-items: center; }\n.toggle-on  { color: var(--green); }\n.toggle-off { color: var(--gray-300); }\n\n/* Gateways */\n.gateway-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }\n.gateway-card {\n  position: relative;\n  display: flex; flex-direction: column; align-items: flex-start;\n  padding: 16px;\n  border: 1.5px solid var(--gray-200); border-radius: var(--radius-md);\n  text-align: left; cursor: pointer;\n  transition: border-color .15s, background .15s;\n}\n.gateway-card:hover { border-color: var(--gray-400); }\n.gateway-card.is-selected { border-color: var(--green); background: var(--green-light); }\n.gateway-logo { font-size: 22px; margin-bottom: 8px; }\n.gateway-name { font-size: 14px; font-weight: 700; color: var(--gray-900); margin-bottom: 3px; }\n.gateway-desc { font-size: 11.5px; color: var(--gray-500); }\n.gateway-check {\n  position: absolute; top: 10px; right: 10px;\n  width: 20px; height: 20px;\n  background: var(--green); color: white;\n  border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n}\n.gateway-keys { display: flex; flex-direction: column; gap: 14px; }\n.gateway-keys-title { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n\n.cash-setting {\n  display: flex; align-items: center; justify-content: space-between; gap: 16px;\n  padding: 16px;\n  background: var(--gray-50);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n}\n.cash-setting-label { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.cash-setting-sub { font-size: 12px; color: var(--gray-400); margin-top: 2px; }\n\n/* Pricing rules */\n.pricing-rules-list { display: flex; flex-direction: column; gap: 6px; }\n.pricing-rule-row {\n  display: flex; align-items: center; gap: 14px;\n  padding: 14px 16px;\n  background: var(--gray-50);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-md);\n  transition: background .12s;\n}\n.pricing-rule-row:hover { background: var(--white); }\n.pricing-rule-row.rule-inactive { opacity: 0.5; }\n.rule-info { flex: 1; }\n.rule-name { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.rule-meta { display: flex; align-items: center; gap: 8px; margin-top: 4px; }\n.rule-type-badge { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: var(--radius-pill); text-transform: capitalize; }\n.type-days { background: var(--blue-bg); color: var(--blue); }\n.type-time { background: var(--amber-bg); color: var(--amber); }\n.type-date { background: var(--purple-bg); color: var(--purple); }\n.rule-trigger { font-size: 12px; color: var(--gray-500); }\n.rule-effect { font-size: 14px; font-weight: 700; min-width: 48px; text-align: right; }\n.effect-up   { color: var(--red); }\n.effect-down { color: var(--green); }\n\n.add-rule-btn {\n  display: inline-flex; align-items: center; gap: 8px;\n  height: 38px; padding: 0 18px;\n  border: 1.5px dashed var(--green);\n  border-radius: var(--radius-md);\n  font-size: 13px; font-weight: 500;\n  color: var(--green-dark);\n  transition: background .12s;\n}\n.add-rule-btn:hover { background: var(--green-light); }\n\n/* Notifications */\n.notif-list { display: flex; flex-direction: column; gap: 0; }\n.notif-row {\n  display: flex; align-items: center; justify-content: space-between; gap: 16px;\n  padding: 14px 0;\n  border-bottom: 1px solid var(--gray-100);\n}\n.notif-row:last-child { border-bottom: none; }\n.notif-label { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.notif-sub { font-size: 12px; color: var(--gray-400); margin-top: 2px; }\n\n/* Plan */\n.plan-current {\n  background: linear-gradient(135deg, #0F6E56, #1D9E75);\n  border-radius: var(--radius-lg);\n  padding: 24px;\n  color: white;\n}\n.plan-badge {\n  display: inline-block;\n  font-size: 10.5px; font-weight: 700;\n  background: rgba(255,255,255,.2);\n  padding: 3px 10px; border-radius: var(--radius-pill);\n  letter-spacing: .05em;\n  margin-bottom: 10px;\n}\n.plan-name { font-size: 22px; font-weight: 800; margin-bottom: 6px; }\n.plan-price { font-size: 32px; font-weight: 800; margin-bottom: 6px; }\n.plan-price span { font-size: 16px; font-weight: 400; opacity: 0.7; }\n.plan-renews { font-size: 12px; opacity: 0.7; }\n\n.plan-features { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.plan-feature-item {\n  display: flex; align-items: center; gap: 8px;\n  font-size: 13px; color: var(--gray-700);\n}\n\n.billing-history-title { font-size: 14px; font-weight: 700; color: var(--gray-900); padding-bottom: 10px; border-bottom: 1px solid var(--gray-100); }\n.billing-list { display: flex; flex-direction: column; }\n.billing-row {\n  display: grid; grid-template-columns: 1fr 80px 80px auto;\n  align-items: center; gap: 12px;\n  padding: 10px 0; border-bottom: 1px solid var(--gray-100);\n  font-size: 13px;\n}\n.billing-row:last-child { border-bottom: none; }\n.billing-date { color: var(--gray-700); }\n.billing-amount { font-weight: 700; color: var(--gray-900); }\n.billing-status { color: var(--green-darker); font-weight: 600; }\n.billing-dl { font-size: 12px; color: var(--green-dark); font-weight: 500; }\n.billing-dl:hover { color: var(--green); }\n\n.btn-sm { height: 30px; padding: 0 12px; font-size: 12px; border-radius: 8px; display: inline-flex; align-items: center; gap: 4px; }\n.btn-primary { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: var(--radius-md); font-size: 13px; font-weight: 500; background: var(--gray-900); color: white; transition: background .15s; }\n.btn-primary:hover { background: var(--gray-700); }\n.btn-secondary { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: var(--radius-md); font-size: 13px; font-weight: 500; background: var(--white); color: var(--gray-900); border: 1px solid var(--gray-200); transition: border-color .15s; }\n.btn-secondary:hover { border-color: var(--gray-400); }\n\n@media (max-width: 800px) {\n  .settings-layout { grid-template-columns: 1fr; }\n  .settings-nav { flex-direction: row; flex-wrap: wrap; padding: 6px; gap: 4px; }\n  .settings-nav-item { flex: 1; min-width: 120px; font-size: 12px; padding: 8px; }\n  .gateway-grid { grid-template-columns: 1fr; }\n  .plan-features { grid-template-columns: 1fr; }\n}\n"],["STYLE",{},"/* ─── Admin / role dashboard shared ──────────────────────────────────────── */\n.admin-layout { display: flex; min-height: 100vh; background: var(--gray-50); }\n\n.admin-sidebar {\n  width: 220px;\n  background: var(--gray-900);\n  display: flex; flex-direction: column;\n  position: fixed; top: 0; left: 0; bottom: 0;\n  z-index: 50;\n  transition: transform .25s;\n}\n.admin-sidebar-header { padding: 18px 16px 12px; border-bottom: 1px solid var(--gray-800); }\n.admin-brand { display: flex; align-items: center; gap: 8px; }\n.admin-brand-name { font-size: 18px; font-weight: 800; color: var(--white); letter-spacing: -.015em; }\n.admin-brand-name em { font-style: normal; color: var(--green-mid); }\n.admin-role-tag { font-size: 9px; font-weight: 700; letter-spacing: .1em; background: rgba(29,158,117,.2); color: var(--green-mid); padding: 2px 6px; border-radius: 4px; }\n\n.admin-user-card { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--gray-800); }\n.admin-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--green); color: var(--white); font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.admin-avatar.sm { width: 30px; height: 30px; font-size: 11px; }\n.admin-user-name { font-size: 12.5px; font-weight: 600; color: var(--white); }\n.admin-user-role { font-size: 11px; color: var(--gray-500); }\n\n.admin-nav { flex: 1; padding: 10px 10px; display: flex; flex-direction: column; gap: 2px; overflow-y: auto; }\n.admin-nav-item {\n  display: flex; align-items: center; gap: 10px;\n  padding: 9px 12px;\n  border-radius: var(--radius-md);\n  font-size: 13px; font-weight: 500;\n  color: var(--gray-400);\n  text-align: left;\n  transition: background .12s, color .12s;\n}\n.admin-nav-item:hover { background: var(--gray-800); color: var(--white); }\n.admin-nav-item.active { background: var(--green-darker); color: var(--white); }\n\n.admin-sidebar-footer { padding: 12px 16px; border-top: 1px solid var(--gray-800); }\n.admin-switch-label { font-size: 10px; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }\n.admin-switch-btns { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }\n.admin-switch-btn { height: 28px; padding: 0 10px; border-radius: 6px; font-size: 11.5px; font-weight: 600; background: rgba(255,255,255,.08); color: var(--gray-300); transition: background .12s; }\n.admin-switch-btn:hover { background: rgba(255,255,255,.15); }\n.admin-logout { display: flex; align-items: center; gap: 8px; width: 100%; padding: 8px 10px; border-radius: var(--radius-md); color: var(--gray-500); font-size: 12.5px; transition: background .12s; }\n.admin-logout:hover { background: var(--gray-800); color: var(--white); }\n\n.admin-main { flex: 1; margin-left: 220px; display: flex; flex-direction: column; min-height: 100vh; }\n.admin-topbar {\n  position: sticky; top: 0; z-index: 30;\n  background: var(--white); border-bottom: 1px solid var(--gray-100);\n  height: 60px; display: flex; align-items: center; gap: 14px; padding: 0 24px;\n}\n.admin-mobile-menu { display: none; color: var(--gray-500); }\n.admin-topbar-search { position: relative; flex: 1; max-width: 360px; }\n.admin-topbar-search input { width: 100%; height: 36px; border: 1px solid var(--gray-200); border-radius: var(--radius-md); font-size: 13px; background: var(--gray-50); color: var(--gray-900); padding: 0 12px; }\n.admin-topbar-search input:focus { outline: none; border-color: var(--green); }\n.admin-icon-btn { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gray-500); transition: background .12s; }\n.admin-icon-btn:hover { background: var(--gray-100); }\n\n.admin-content { flex: 1; padding: 24px; max-width: 1300px; }\n\n.admin-overview { display: flex; flex-direction: column; gap: 20px; }\n.admin-kpi-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }\n.admin-kpi-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-card); }\n.admin-kpi-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }\n.icon-green  { background: var(--green-light);  color: var(--green-dark); }\n.icon-blue   { background: var(--blue-bg);      color: var(--blue); }\n.icon-purple { background: var(--purple-bg);    color: var(--purple); }\n.icon-amber  { background: var(--amber-bg);     color: var(--amber); }\n.admin-kpi-value { font-size: 26px; font-weight: 800; color: var(--gray-900); letter-spacing: -.02em; }\n.admin-kpi-label { font-size: 12.5px; color: var(--gray-500); margin-top: 3px; }\n.admin-kpi-change { font-size: 12px; color: var(--green-dark); font-weight: 600; margin-top: 6px; }\n\n.admin-chart-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: 20px 24px; box-shadow: var(--shadow-card); }\n.admin-chart-card h3 { font-size: 15px; font-weight: 700; margin-bottom: 16px; }\n\n.admin-table-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); overflow: hidden; }\n.admin-table { width: 100%; border-collapse: collapse; font-size: 13px; }\n.admin-table th { text-align: left; font-size: 11px; font-weight: 600; color: var(--gray-400); text-transform: uppercase; letter-spacing: .05em; padding: 12px 16px; border-bottom: 1px solid var(--gray-100); }\n.admin-table td { padding: 12px 16px; border-bottom: 1px solid var(--gray-100); }\n.admin-table tr:last-child td { border-bottom: none; }\n.admin-table tr:hover td { background: var(--gray-50); }\n.admin-td-shop { font-weight: 600; color: var(--gray-900); }\n.plan-pill { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: var(--radius-pill); background: var(--blue-bg); color: var(--blue); }\n.status-pill { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: var(--radius-pill); }\n.st-active { background: var(--green-light); color: var(--green-darker); }\n.st-suspended { background: var(--red-bg); color: var(--red); }\n.admin-row-btn { width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; color: var(--gray-400); border: 1px solid var(--gray-200); transition: background .12s; }\n.admin-row-btn:hover { background: var(--gray-100); color: var(--gray-700); }\n.admin-row-btn-danger:hover { background: var(--red-bg); color: var(--red); border-color: #FECACA; }\n\n.admin-stub { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; min-height: 300px; text-align: center; }\n.admin-stub-icon { width: 64px; height: 64px; border-radius: 16px; background: var(--green-light); color: var(--green-dark); display: flex; align-items: center; justify-content: center; }\n.admin-stub h2 { font-size: 20px; font-weight: 700; }\n.admin-stub p { font-size: 14px; color: var(--gray-400); max-width: 360px; line-height: 1.6; }\n\n.page-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }\n.page-title { font-size: 22px; font-weight: 800; color: var(--gray-900); letter-spacing: -.02em; }\n.page-subtitle { font-size: 13px; color: var(--gray-500); margin-top: 2px; }\n\n@media (max-width: 900px) {\n  .admin-sidebar { transform: translateX(-100%); }\n  .admin-sidebar.open { transform: translateX(0); box-shadow: 4px 0 20px rgba(0,0,0,.2); }\n  .admin-mobile-menu { display: flex; }\n  .admin-main { margin-left: 0; }\n  .admin-kpi-grid { grid-template-columns: repeat(2,1fr); }\n}\n"],["STYLE",{},".admin-filter-bar { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:14px; }\n.admin-filter-input { height:38px; border:1px solid var(--gray-200); border-radius:var(--radius-md); padding:0 12px; font-size:13px; color:var(--gray-900); background:var(--white); transition:border-color .15s; }\n.admin-filter-input:focus { outline:none; border-color:var(--green); }\n.admin-filter-select { height:38px; border:1px solid var(--gray-200); border-radius:var(--radius-md); padding:0 10px; font-size:13px; color:var(--gray-700); background:var(--white); cursor:pointer; }\n.role-badge-sm { display:inline-flex; align-items:center; font-size:10.5px; font-weight:600; padding:2px 8px; border-radius:var(--radius-pill); text-transform:capitalize; }\n.role-green  { background:var(--green-light);  color:var(--green-darker); }\n.role-blue   { background:var(--blue-bg);      color:var(--blue); }\n.role-purple { background:var(--purple-bg);    color:var(--purple); }\n.role-amber  { background:var(--amber-bg);     color:var(--amber); }\n.role-gray   { background:var(--gray-100);     color:var(--gray-600); }\n.toggle-status-btn { display:inline-flex; align-items:center; gap:5px; height:26px; padding:0 10px; border-radius:6px; font-size:11px; font-weight:600; }\n.tog-active    { background:var(--green-light);  color:var(--green-darker); }\n.tog-suspended { background:var(--red-bg);       color:var(--red); }\n.toggle-btn { display:flex; align-items:center; }\n.toggle-on  { color:var(--green); }\n.toggle-off { color:var(--gray-300); }\n.modal-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.4); display:flex; align-items:center; justify-content:center; z-index:200; padding:16px; }\n.modal { background:var(--white); border-radius:var(--radius-xl); width:100%; max-width:500px; box-shadow:var(--shadow-lg); display:flex; flex-direction:column; max-height:90vh; overflow:hidden; }\n.modal-header { display:flex; align-items:center; justify-content:space-between; padding:20px 24px 16px; border-bottom:1px solid var(--gray-100); }\n.modal-title { font-size:16px; font-weight:700; }\n.modal-close { width:30px; height:30px; display:flex; align-items:center; justify-content:center; border-radius:8px; color:var(--gray-400); }\n.modal-close:hover { background:var(--gray-100); }\n.modal-body { padding:20px 24px; overflow-y:auto; display:flex; flex-direction:column; gap:14px; }\n.modal-footer { display:flex; gap:10px; justify-content:flex-end; padding:16px 24px; border-top:1px solid var(--gray-100); }\n.form-field { display:flex; flex-direction:column; gap:5px; }\n.form-label { font-size:12px; font-weight:600; color:var(--gray-700); }\n.form-input { height:40px; border:1px solid var(--gray-200); border-radius:var(--radius-md); padding:0 12px; font-size:13.5px; color:var(--gray-900); transition:border-color .15s; }\n.form-input:focus { outline:none; border-color:var(--green); }\n.form-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }\n.btn { height:38px; padding:0 16px; border-radius:var(--radius-md); font-size:13px; font-weight:600; display:inline-flex; align-items:center; gap:6px; }\n.btn-primary { background:var(--gray-900); color:var(--white); }\n.btn-secondary { background:var(--white); color:var(--gray-700); border:1px solid var(--gray-200); }\n.btn-refresh { display:inline-flex; align-items:center; gap:6px; height:36px; padding:0 14px; border-radius:var(--radius-md); font-size:13px; font-weight:500; background:var(--white); color:var(--gray-700); border:1px solid var(--gray-200); }\n"],["STYLE",{},"/* ─── Support Dashboard ───────────────────────────────────────────────────── */\n.support-tag { background: rgba(217,119,6,.2) !important; color: #FCD34D !important; }\n.support-nav-badge {\n  margin-left: auto;\n  background: var(--red);\n  color: var(--white);\n  font-size: 10px; font-weight: 700;\n  min-width: 18px; height: 18px;\n  border-radius: 9px;\n  display: flex; align-items: center; justify-content: center;\n  padding: 0 4px;\n}\n.support-bell-dot {\n  position: absolute; top: 6px; right: 6px;\n  width: 7px; height: 7px;\n  border-radius: 50%; background: var(--red);\n  border: 2px solid var(--white);\n}\n\n/* Overview */\n.support-overview { display: flex; flex-direction: column; gap: 20px; }\n\n.btn-refresh {\n  display: inline-flex; align-items: center; gap: 6px;\n  height: 36px; padding: 0 14px;\n  border-radius: var(--radius-md);\n  font-size: 13px; font-weight: 500;\n  background: var(--white); color: var(--gray-700);\n  border: 1px solid var(--gray-200);\n  transition: border-color .12s;\n}\n.btn-refresh:hover { border-color: var(--gray-400); }\n\n.support-alert-banner {\n  display: flex; align-items: center; gap: 12px;\n  background: var(--red-bg);\n  border: 1px solid #FECACA;\n  border-radius: var(--radius-md);\n  padding: 12px 16px;\n  font-size: 13.5px; color: var(--red);\n}\n.support-alert-banner strong { font-weight: 700; }\n.support-alert-action {\n  margin-left: auto;\n  font-size: 12.5px; font-weight: 700; color: var(--red);\n  white-space: nowrap;\n}\n\n/* KPI */\n.kpi-clickable { cursor: pointer; text-align: left; width: 100%; transition: transform .12s, box-shadow .12s; }\n.kpi-clickable:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }\n.kpi-click-hint { font-size: 11px; color: var(--gray-400); margin-top: 6px; }\n.icon-red { background: var(--red-bg) !important; color: var(--red) !important; }\n\n.support-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n\n/* Panels */\n.support-panel {\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg);\n  padding: 20px;\n  box-shadow: var(--shadow-card);\n  display: flex; flex-direction: column; gap: 0;\n}\n.support-panel-header {\n  display: flex; align-items: center; justify-content: space-between;\n  margin-bottom: 14px;\n}\n.support-panel-header h3 { font-size: 14.5px; font-weight: 700; color: var(--gray-900); }\n.panel-view-all { font-size: 12.5px; font-weight: 600; color: var(--green-dark); }\n.panel-view-all:hover { color: var(--green); }\n.support-empty { text-align: center; font-size: 13px; color: var(--gray-400); padding: 24px; }\n\n/* Payment rows */\n.support-pay-row {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 10px 0;\n  border-bottom: 1px solid var(--gray-100);\n}\n.support-pay-row:last-child { border-bottom: none; }\n.support-pay-id { font-size: 12.5px; font-weight: 700; color: var(--gray-900); }\n.support-pay-shop { font-size: 11.5px; color: var(--gray-400); margin-top: 2px; }\n.support-pay-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }\n.support-pay-amount { font-size: 13.5px; font-weight: 700; color: var(--gray-900); }\n\n/* Payment status pills */\n.pay-status-pill {\n  display: inline-flex; align-items: center;\n  font-size: 10.5px; font-weight: 700;\n  padding: 2px 8px; border-radius: var(--radius-pill);\n  text-transform: capitalize;\n}\n.ps-captured { background: var(--green-light);  color: var(--green-darker); }\n.ps-pending  { background: var(--amber-bg);     color: var(--amber); }\n.ps-failed   { background: var(--red-bg);       color: var(--red); }\n.ps-refunded { background: var(--blue-bg);      color: var(--blue); }\n.ps-cash     { background: var(--gray-100);     color: var(--gray-600); }\n\n/* Tickets */\n.support-filter-tabs { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }\n.support-filter-tab {\n  display: inline-flex; align-items: center; gap: 6px;\n  height: 32px; padding: 0 12px;\n  border-radius: var(--radius-pill);\n  font-size: 12.5px; font-weight: 500;\n  background: var(--white); color: var(--gray-600);\n  border: 1px solid var(--gray-200);\n  transition: all .12s;\n}\n.support-filter-tab.active { background: var(--gray-900); color: var(--white); border-color: var(--gray-900); }\n.support-filter-tab:hover:not(.active) { border-color: var(--gray-400); }\n.support-filter-count {\n  background: var(--gray-100); color: var(--gray-500);\n  font-size: 10px; font-weight: 700;\n  padding: 1px 6px; border-radius: 99px;\n}\n.support-filter-tab.active .support-filter-count { background: rgba(255,255,255,.15); color: var(--white); }\n\n.ticket-row {\n  display: grid;\n  grid-template-columns: 80px 1fr auto auto;\n  align-items: center; gap: 14px;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--gray-100);\n}\n.ticket-row:last-child { border-bottom: none; }\n.ticket-row.ticket-row-compact { grid-template-columns: 70px 1fr auto; gap: 10px; padding: 10px 0; }\n.ticket-row.ticket-row-compact .ticket-actions { display: none; }\n.ticket-id { font-size: 12px; font-weight: 700; color: var(--gray-400); font-variant-numeric: tabular-nums; }\n.ticket-subject { font-size: 13.5px; font-weight: 600; color: var(--gray-900); margin-bottom: 4px; }\n.ticket-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\n.ticket-user { font-size: 12px; color: var(--gray-600); font-weight: 500; }\n.ticket-role-tag {\n  font-size: 10.5px; font-weight: 600;\n  background: var(--gray-100); color: var(--gray-500);\n  padding: 1px 7px; border-radius: var(--radius-pill);\n  text-transform: capitalize;\n}\n.ticket-time { font-size: 11.5px; color: var(--gray-400); }\n.ticket-badges { display: flex; flex-direction: column; gap: 4px; align-items: flex-end; }\n.ticket-actions { display: flex; gap: 6px; }\n\n.priority-pill {\n  display: inline-flex; align-items: center;\n  font-size: 10px; font-weight: 700;\n  padding: 2px 8px; border-radius: var(--radius-pill);\n  text-transform: uppercase; letter-spacing: .04em;\n}\n.pri-urgent { background: var(--red-bg);    color: var(--red); }\n.pri-high   { background: var(--amber-bg);  color: var(--amber); }\n.pri-medium { background: var(--blue-bg);   color: var(--blue); }\n.pri-low    { background: var(--gray-100);  color: var(--gray-500); }\n\n.ticket-status-pill {\n  font-size: 10.5px; font-weight: 600;\n  padding: 2px 8px; border-radius: var(--radius-pill);\n}\n.tst-open     { background: var(--red-bg);    color: var(--red); }\n.tst-pending  { background: var(--amber-bg);  color: var(--amber); }\n.tst-resolved { background: var(--green-light); color: var(--green-darker); }\n\n.support-action-btn {\n  height: 28px; padding: 0 11px;\n  border-radius: 7px; font-size: 12px; font-weight: 600;\n  background: var(--white); color: var(--gray-700);\n  border: 1px solid var(--gray-200);\n  transition: border-color .12s, background .12s;\n  white-space: nowrap;\n}\n.support-action-btn:hover { border-color: var(--gray-400); }\n.support-action-primary { background: var(--gray-900) !important; color: var(--white) !important; border-color: var(--gray-900) !important; }\n.support-action-primary:hover { background: var(--gray-700) !important; }\n\n/* Table extras */\n.support-order-id { font-size: 12px; font-weight: 700; color: var(--gray-900); font-variant-numeric: tabular-nums; }\n.support-time-cell { font-size: 12px; color: var(--gray-400); }\n.issue-badge {\n  display: inline-flex; align-items: center; gap: 4px;\n  font-size: 10.5px; font-weight: 600;\n  background: var(--red-bg); color: var(--red);\n  padding: 2px 8px; border-radius: var(--radius-pill);\n  white-space: nowrap;\n}\n\n/* Payment KPI chips */\n.support-kpi-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-bottom: 16px; }\n.support-kpi-chip { border-radius: var(--radius-md); padding: 14px; border: 1px solid var(--gray-200); background: var(--white); }\n.support-kpi-chip-val { font-size: 20px; font-weight: 800; margin-bottom: 4px; }\n.support-kpi-chip-lbl { font-size: 12px; }\n.support-kpi-green { border-color: #A7F3D0; }\n.support-kpi-green .support-kpi-chip-val { color: var(--green-darker); }\n.support-kpi-amber { border-color: #FDE68A; }\n.support-kpi-amber .support-kpi-chip-val { color: var(--amber); }\n.support-kpi-red   { border-color: #FECACA; }\n.support-kpi-red .support-kpi-chip-val   { color: var(--red); }\n.support-kpi-blue  { border-color: #BFDBFE; }\n.support-kpi-blue .support-kpi-chip-val  { color: var(--blue); }\n\n/* Search */\n.support-search-row { position: relative; }\n.support-search-input { height: 38px; border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 0 12px; font-size: 13px; width: 240px; }\n.support-search-input:focus { outline: none; border-color: var(--green); }\n\n/* Role chip small */\n.role-chip-sm {\n  font-size: 10.5px; font-weight: 600;\n  padding: 2px 8px; border-radius: var(--radius-pill);\n  background: var(--gray-100); color: var(--gray-600);\n  text-transform: capitalize;\n}\n\n/* QR type badges */\n.qr-type-badge {\n  font-size: 10.5px; font-weight: 600;\n  padding: 2px 8px; border-radius: var(--radius-pill);\n  text-transform: capitalize;\n}\n.qr-type-green  { background: var(--green-light);  color: var(--green-darker); }\n.qr-type-blue   { background: var(--blue-bg);      color: var(--blue); }\n.qr-type-purple { background: var(--purple-bg);    color: var(--purple); }\n\n/* OCR jobs */\n.ocr-job-row {\n  display: flex; align-items: center; gap: 14px;\n  padding: 13px 0; border-bottom: 1px solid var(--gray-100);\n}\n.ocr-job-row:last-child { border-bottom: none; }\n.ocr-job-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--gray-100); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.ocr-job-info { flex: 1; }\n.ocr-job-shop { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.ocr-job-file { font-size: 12px; color: var(--gray-400); margin-top: 2px; font-family: monospace; }\n.ocr-job-items { font-size: 12.5px; color: var(--gray-600); min-width: 160px; }\n.ocr-job-time { font-size: 12px; color: var(--gray-400); min-width: 80px; text-align: right; }\n.ocr-status-pill {\n  font-size: 10.5px; font-weight: 700;\n  padding: 3px 9px; border-radius: var(--radius-pill);\n}\n.ocr-done       { background: var(--green-light); color: var(--green-darker); }\n.ocr-failed     { background: var(--red-bg);      color: var(--red); }\n.ocr-processing { background: var(--blue-bg);     color: var(--blue); }\n\n/* Audit logs */\n.audit-row {\n  display: flex; align-items: flex-start; gap: 12px;\n  padding: 12px 0; border-bottom: 1px solid var(--gray-100);\n}\n.audit-row:last-child { border-bottom: none; }\n.audit-level-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 6px; }\n.audit-info  { background: var(--green); }\n.audit-warn  { background: var(--amber); }\n.audit-error { background: var(--red); }\n.audit-body { flex: 1; }\n.audit-action { font-size: 13.5px; color: var(--gray-900); line-height: 1.5; }\n.audit-meta { display: flex; gap: 12px; margin-top: 4px; flex-wrap: wrap; }\n.audit-actor { font-size: 12px; font-weight: 600; color: var(--gray-500); }\n.audit-time { font-size: 12px; color: var(--gray-400); }\n\n/* Impersonation */\n.impersonate-warning {\n  display: flex; align-items: flex-start; gap: 12px;\n  background: var(--amber-bg);\n  border: 1px solid #FDE68A;\n  border-radius: var(--radius-md);\n  padding: 14px 16px;\n  font-size: 13.5px; color: var(--amber);\n  margin-bottom: 20px;\n}\n.impersonate-warning strong { color: #92400E; }\n.impersonate-layout { display: grid; grid-template-columns: 1fr 380px; gap: 16px; align-items: start; }\n.impersonate-user-row {\n  display: flex; align-items: center; gap: 12px;\n  padding: 12px 14px; margin: 0 -4px;\n  border-radius: var(--radius-md);\n  text-align: left; width: calc(100% + 8px);\n  transition: background .12s;\n}\n.impersonate-user-row:hover { background: var(--gray-50); }\n.impersonate-user-row.selected { background: var(--green-light); }\n.imp-avatar {\n  width: 36px; height: 36px; border-radius: 50%;\n  background: var(--green); color: var(--white);\n  font-size: 12px; font-weight: 700;\n  display: flex; align-items: center; justify-content: center; flex-shrink: 0;\n}\n.imp-avatar.large { width: 52px; height: 52px; font-size: 16px; flex-shrink: 0; }\n.imp-name { font-size: 13.5px; font-weight: 600; color: var(--gray-900); }\n.imp-email { font-size: 12px; color: var(--gray-400); }\n\n.impersonate-form-panel {\n  background: var(--white); border: 1px solid var(--gray-200);\n  border-radius: var(--radius-lg); padding: 22px;\n  box-shadow: var(--shadow-card);\n  display: flex; flex-direction: column; gap: 16px;\n}\n.impersonate-form-title { font-size: 15px; font-weight: 700; color: var(--gray-900); }\n.impersonate-target-card {\n  display: flex; align-items: center; gap: 14px;\n  background: var(--gray-50); border-radius: var(--radius-md); padding: 14px;\n}\n.impersonate-field { display: flex; flex-direction: column; gap: 6px; }\n.impersonate-field label { font-size: 12.5px; font-weight: 600; color: var(--gray-700); }\n.impersonate-field textarea {\n  border: 1.5px solid var(--gray-200); border-radius: var(--radius-md);\n  padding: 10px 12px; font-size: 13px; color: var(--gray-900);\n  resize: vertical; font-family: var(--font-sans); line-height: 1.5;\n  transition: border-color .15s;\n}\n.impersonate-field textarea:focus { outline: none; border-color: var(--amber); }\n.impersonate-start-btn {\n  height: 44px; border-radius: var(--radius-md);\n  font-size: 14px; font-weight: 700;\n  background: var(--amber); color: var(--white);\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n  transition: background .12s;\n}\n.impersonate-start-btn:hover { background: #B45309; }\n.impersonate-start-btn:disabled { opacity: .45; cursor: not-allowed; }\n.impersonate-success {\n  display: flex; align-items: center; gap: 8px;\n  background: var(--green-light); border: 1px solid #A7F3D0;\n  border-radius: var(--radius-md); padding: 12px 14px;\n  font-size: 13px; font-weight: 600; color: var(--green-darker);\n}\n.impersonate-placeholder {\n  display: flex; flex-direction: column; align-items: center; gap: 10px;\n  padding: 40px 20px; text-align: center;\n}\n.impersonate-placeholder p { font-size: 13px; color: var(--gray-400); }\n\n/* Responsive */\n@media (max-width: 900px) {\n  .support-two-col { grid-template-columns: 1fr; }\n  .support-kpi-row { grid-template-columns: repeat(2,1fr); }\n  .impersonate-layout { grid-template-columns: 1fr; }\n  .ticket-row { grid-template-columns: 1fr auto; gap: 10px; }\n  .ticket-id { display: none; }\n}\n"],["STYLE",{},".supplier-tag { background: rgba(37,99,235,.2)!important; color: #60A5FA!important; }\n.outlets-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(260px,1fr)); gap: 14px; }\n.outlet-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: 18px; box-shadow: var(--shadow-card); }\n.outlet-name { font-size: 14px; font-weight: 700; color: var(--gray-900); margin-bottom: 8px; }\n.outlet-status { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: var(--radius-pill); display: inline-block; margin-bottom: 14px; }\n.outlet-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.outlet-stat-val { font-size: 20px; font-weight: 700; color: var(--gray-900); }\n.outlet-stat-lbl { font-size: 11.5px; color: var(--gray-400); }\n.btn-outline { height: 36px; padding: 0 16px; border-radius: var(--radius-md); font-size: 13px; font-weight: 600; border: 1.5px solid var(--gray-200); color: var(--gray-700); background: var(--white); transition: border-color .12s, color .12s; }\n.btn-outline:hover { border-color: var(--green); color: var(--green-dark); }\n.btn-sm { height: 30px; padding: 0 12px; font-size: 12px; }\n"],["STYLE",{},".sub-page { display:flex; flex-direction:column; gap:20px; }\n.sub-billing-toggle { display:flex; border:1px solid var(--gray-200); border-radius:var(--radius-md); overflow:hidden; }\n.sub-toggle-btn { height:38px; padding:0 16px; font-size:13px; font-weight:500; color:var(--gray-500); background:var(--white); display:flex; align-items:center; gap:6px; transition:all .12s; }\n.sub-toggle-btn.active { background:var(--gray-900); color:var(--white); }\n.sub-save-badge { font-size:10px; font-weight:700; background:var(--green); color:var(--white); padding:2px 6px; border-radius:99px; }\n.sub-current-banner { display:flex; align-items:center; justify-content:space-between; background:var(--green-light); border:1px solid #A7F3D0; border-radius:var(--radius-md); padding:14px 18px; }\n.sub-current-left { display:flex; align-items:center; gap:12px; }\n.sub-current-name { font-size:15px; font-weight:700; color:var(--gray-900); }\n.sub-current-meta { font-size:12px; color:var(--gray-500); margin-top:2px; }\n.sub-manage-btn { height:34px; padding:0 14px; border-radius:var(--radius-md); font-size:12.5px; font-weight:600; border:1.5px solid var(--green); color:var(--green-dark); background:var(--white); transition:background .12s; }\n.sub-manage-btn:hover { background:var(--green-light); }\n.sub-plans-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }\n.sub-plan-card { position:relative; background:var(--white); border:1.5px solid var(--gray-200); border-radius:var(--radius-xl); padding:24px; display:flex; flex-direction:column; gap:14px; cursor:pointer; transition:border-color .15s, box-shadow .15s; }\n.sub-plan-card:hover { border-color:var(--gray-400); box-shadow:var(--shadow-md); }\n.sub-plan-card.is-selected { border-color:var(--green); box-shadow:0 0 0 3px rgba(29,158,117,.1); }\n.sub-plan-card.is-current { border-color:var(--green); }\n.sub-plan-tag,.sub-current-tag { position:absolute; top:-11px; left:50%; transform:translateX(-50%); font-size:10.5px; font-weight:700; padding:3px 12px; border-radius:99px; white-space:nowrap; }\n.sub-plan-tag { background:var(--green); color:var(--white); }\n.sub-current-tag { background:var(--blue); color:var(--white); }\n.sub-plan-icon { width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; }\n.sub-plan-name { font-size:17px; font-weight:800; color:var(--gray-900); }\n.sub-plan-price { font-size:30px; font-weight:800; color:var(--gray-900); letter-spacing:-.02em; }\n.sub-plan-price span { font-size:14px; font-weight:400; color:var(--gray-400); }\n.sub-plan-features { list-style:none; display:flex; flex-direction:column; gap:8px; flex:1; }\n.sub-plan-features li { display:flex; align-items:flex-start; gap:7px; font-size:13px; color:var(--gray-600); }\n.sub-plan-btn { height:42px; border-radius:var(--radius-md); font-size:13.5px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:6px; border:1.5px solid var(--gray-200); color:var(--gray-700); background:var(--white); transition:all .12s; }\n.sub-plan-btn:hover { border-color:var(--green); color:var(--green-dark); }\n.sub-btn-primary { background:var(--green)!important; color:var(--white)!important; border-color:var(--green)!important; }\n.sub-btn-primary:hover { background:var(--green-dark)!important; }\n.sub-btn-cancel { color:var(--red)!important; border-color:var(--red)!important; font-size:12.5px; }\n.sub-billing-section { background:var(--white); border:1px solid var(--gray-200); border-radius:var(--radius-lg); padding:20px; box-shadow:var(--shadow-card); }\n.sub-section-title { font-size:15px; font-weight:700; margin-bottom:14px; }\n.sub-billing-table { display:flex; flex-direction:column; gap:0; }\n.sub-billing-row { display:grid; grid-template-columns:1fr 130px 80px 70px auto; align-items:center; gap:12px; padding:11px 0; border-bottom:1px solid var(--gray-100); font-size:13px; }\n.sub-billing-row:last-child { border-bottom:none; }\n.sub-billing-date { color:var(--gray-600); }\n.sub-billing-inv { color:var(--gray-400); font-size:12px; }\n.sub-billing-amount { font-weight:700; }\n.sub-billing-status { color:var(--green-darker); font-weight:600; }\n.sub-billing-dl { display:inline-flex; align-items:center; gap:4px; font-size:12px; color:var(--blue); font-weight:500; }\n.sub-tip { display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--gray-500); padding:12px 16px; background:var(--gray-50); border-radius:var(--radius-md); border:1px solid var(--gray-100); }\n.sub-link { color:var(--green-dark); font-weight:600; }\n@media(max-width:800px){ .sub-plans-grid{grid-template-columns:1fr;} .sub-billing-row{grid-template-columns:1fr auto;} }\n"],["STYLE",{},".hotel-tag { background: rgba(124,58,237,.2)!important; color: #C4B5FD!important; }\n.hotel-services-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }\n.hotel-service-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: 8px; }\n.hotel-service-icon { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }\n.hotel-service-label { font-size: 14px; font-weight: 700; color: var(--gray-900); }\n.hotel-service-count { font-size: 12px; color: var(--gray-400); }\n.requests-list { display: flex; flex-direction: column; gap: 8px; }\n.request-row { display: grid; grid-template-columns: 70px 1fr 100px 110px auto; align-items: center; gap: 14px; background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 14px 18px; box-shadow: var(--shadow-card); }\n.req-room { font-size: 14px; font-weight: 800; color: var(--gray-900); }\n.req-info {}\n.req-service { font-size: 12px; font-weight: 600; color: var(--green-darker); margin-bottom: 2px; }\n.req-item { font-size: 13px; color: var(--gray-700); }\n.req-time { font-size: 11.5px; color: var(--gray-400); }\n.req-status { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: var(--radius-pill); text-align: center; }\n.req-new { background: var(--amber-bg); color: var(--amber); }\n.req-preparing { background: var(--blue-bg); color: var(--blue); }\n.req-confirmed { background: var(--green-light); color: var(--green-darker); }\n.req-done { background: var(--gray-100); color: var(--gray-500); }\n.req-action-btn { height: 30px; padding: 0 12px; border-radius: 8px; font-size: 12px; font-weight: 600; background: var(--gray-900); color: var(--white); white-space: nowrap; }\n.req-live-badge { font-size: 12px; font-weight: 600; color: var(--green-dark); }\n@media(max-width:800px){ .hotel-services-grid{grid-template-columns:repeat(2,1fr);} .request-row{grid-template-columns:60px 1fr auto;} .req-time,.req-status{display:none;} }\n"],["STYLE",{},".rooms-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:14px; }\n.room-card { background:var(--white); border:1px solid var(--gray-200); border-radius:var(--radius-lg); padding:16px; box-shadow:var(--shadow-card); }\n.room-card-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }\n.room-number { font-size:17px; font-weight:800; color:var(--gray-900); }\n.room-status-badge { font-size:10.5px; font-weight:700; padding:3px 9px; border-radius:99px; }\n.rs-occupied    { background:var(--green-light); color:var(--green-darker); }\n.rs-vacant      { background:var(--gray-100);    color:var(--gray-600); }\n.rs-maintenance { background:var(--amber-bg);    color:var(--amber); }\n.room-type { font-size:12.5px; color:var(--gray-500); margin-bottom:10px; }\n.room-guest { background:var(--blue-bg); border-radius:8px; padding:8px 10px; margin-bottom:10px; }\n.room-guest-name { font-size:13px; font-weight:600; color:var(--blue); }\n.room-guest-dates { font-size:11.5px; color:var(--gray-500); margin-top:2px; }\n.room-qr-row { display:flex; align-items:center; justify-content:space-between; font-size:12.5px; }\n.btn-room-action { height:28px; padding:0 10px; border-radius:7px; font-size:11.5px; font-weight:600; background:var(--gray-100); color:var(--gray-700); transition:background .12s; }\n.btn-room-action:hover { background:var(--gray-200); }\n.icon-red { background:var(--red-bg)!important; color:var(--red)!important; }\n.support-alert-banner { display:flex; align-items:center; gap:12px; background:var(--red-bg); border:1px solid #FECACA; border-radius:var(--radius-md); padding:12px 16px; font-size:13.5px; color:var(--red); }\n.support-alert-action { margin-left:auto; font-size:12.5px; font-weight:700; color:var(--red); white-space:nowrap; }\n.support-filter-tab { display:inline-flex; align-items:center; gap:6px; height:32px; padding:0 12px; border-radius:99px; font-size:12.5px; font-weight:500; background:var(--white); color:var(--gray-600); border:1px solid var(--gray-200); transition:all .12s; }\n.support-filter-tab.active { background:var(--gray-900); color:var(--white); border-color:var(--gray-900); }\n.support-filter-count { background:var(--gray-100); color:var(--gray-500); font-size:10px; font-weight:700; padding:1px 6px; border-radius:99px; }\n.support-filter-tab.active .support-filter-count { background:rgba(255,255,255,.15); color:var(--white); }\n"],["STYLE",{},"/* ════════════════════════════════════════════════════════════\n   AviQR — Customer Menu  (mobile-first, Indian lang support)\n   ════════════════════════════════════════════════════════════ */\n\n/* Base page — centered, max 480px, real phone feel */\n.cm-page {\n  min-height: 100vh;\n  background: #F8F8F8;\n  max-width: 480px;\n  margin: 0 auto;\n  position: relative;\n  font-family: -apple-system, 'Segoe UI', 'Noto Sans', 'Noto Sans Devanagari',\n               'Noto Sans Tamil', 'Noto Sans Telugu', 'Noto Sans Kannada',\n               'Noto Sans Malayalam', sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ── Header ─────────────────────────────────────────────── */\n.cm-header {\n  position: sticky; top: 0; z-index: 60;\n  background: var(--white);\n  border-bottom: 1px solid #EFEFEF;\n  box-shadow: 0 1px 4px rgba(0,0,0,.06);\n}\n.cm-header-inner {\n  display: flex; align-items: center; justify-content: space-between;\n  height: 52px; padding: 0 16px; gap: 10px;\n}\n.cm-brand { display: flex; align-items: center; gap: 8px; }\n.cm-brand-icon { color: var(--green); }\n.cm-brand-name {\n  font-size: 18px; font-weight: 800; letter-spacing: -.02em;\n  color: #111;\n}\n.cm-brand-name em { font-style: normal; color: var(--green); }\n\n.cm-header-right { display: flex; align-items: center; gap: 8px; }\n\n/* Language picker */\n.cm-lang-wrap { position: relative; }\n.cm-lang-btn {\n  display: inline-flex; align-items: center; gap: 5px;\n  height: 34px; padding: 0 10px;\n  border-radius: 20px;\n  font-size: 12.5px; font-weight: 600;\n  color: var(--gray-700);\n  background: var(--gray-100);\n  border: 1px solid var(--gray-200);\n  transition: background .12s;\n}\n.cm-lang-btn:hover { background: var(--gray-200); }\n.cm-lang-dropdown {\n  position: absolute; top: calc(100% + 6px); right: 0;\n  background: var(--white);\n  border: 1px solid var(--gray-200);\n  border-radius: 14px;\n  box-shadow: 0 8px 28px rgba(0,0,0,.12);\n  overflow: hidden; z-index: 100;\n  min-width: 170px;\n}\n.cm-lang-option {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 11px 14px;\n  font-size: 14px;\n  border-bottom: 1px solid var(--gray-50);\n  transition: background .1s;\n  width: 100%; text-align: left;\n}\n.cm-lang-option:last-child { border-bottom: none; }\n.cm-lang-option:hover { background: var(--gray-50); }\n.cm-lang-option.active { background: var(--green-light); color: var(--green-darker); }\n.cm-lang-native { font-weight: 700; font-size: 15px; }\n.cm-lang-label  { font-size: 11.5px; color: var(--gray-400); }\n.cm-icon-btn {\n  width: 34px; height: 34px; border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  color: var(--gray-500);\n  transition: background .12s;\n}\n.cm-icon-btn:hover { background: var(--gray-100); }\n\n/* ── Shop banner ─────────────────────────────────────────── */\n.cm-shop-banner {\n  background: linear-gradient(135deg, var(--shop-color, #1D9E75) 0%, #085041 100%);\n  padding: 20px 16px 18px;\n  position: relative;\n  overflow: hidden;\n}\n.cm-shop-banner::after {\n  content: '';\n  position: absolute; inset: 0;\n  background: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='2' y='2' width='8' height='8' rx='2' fill='rgba(255,255,255,0.04)'/%3E%3Crect x='14' y='2' width='8' height='8' rx='2' fill='rgba(255,255,255,0.04)'/%3E%3C/svg%3E\") repeat;\n  pointer-events: none;\n}\n.cm-shop-emoji-wrap {\n  width: 56px; height: 56px; border-radius: 16px;\n  background: rgba(255,255,255,.15);\n  display: flex; align-items: center; justify-content: center;\n  margin-bottom: 12px;\n}\n.cm-shop-emoji { font-size: 30px; }\n.cm-shop-name {\n  font-size: 22px; font-weight: 800; color: #fff;\n  letter-spacing: -.02em; margin-bottom: 3px;\n}\n.cm-shop-tagline { font-size: 13px; color: rgba(255,255,255,.65); margin-bottom: 10px; }\n.cm-shop-meta { display: flex; flex-wrap: wrap; gap: 6px; }\n.cm-meta-chip {\n  display: inline-flex; align-items: center; gap: 4px;\n  font-size: 11.5px; color: rgba(255,255,255,.8);\n  background: rgba(255,255,255,.12);\n  padding: 4px 9px; border-radius: 99px;\n}\n.cm-star { color: #FBBF24; }\n.cm-table-chip {\n  position: absolute; top: 16px; right: 16px;\n  background: rgba(255,255,255,.2);\n  backdrop-filter: blur(8px);\n  color: var(--white);\n  font-size: 12px; font-weight: 700;\n  padding: 6px 12px; border-radius: 20px;\n  border: 1px solid rgba(255,255,255,.3);\n}\n\n/* ── Toolbar (search + veg filter) ──────────────────────── */\n.cm-toolbar {\n  display: flex; align-items: center; gap: 10px;\n  padding: 10px 14px;\n  background: var(--white);\n  border-bottom: 1px solid #EFEFEF;\n  position: sticky; top: 52px; z-index: 40;\n}\n.cm-search-wrap {\n  flex: 1; position: relative;\n  display: flex; align-items: center;\n}\n.cm-search-ico { position: absolute; left: 11px; color: #9CA3AF; pointer-events: none; flex-shrink: 0; }\n.cm-search-input {\n  width: 100%; height: 40px;\n  border: 1.5px solid #E5E7EB;\n  border-radius: 99px;\n  padding: 0 34px 0 34px;\n  font-size: 14px; color: #111;\n  background: #F8F8F8;\n  transition: border-color .15s, background .15s;\n  font-family: inherit;\n}\n.cm-search-input:focus { outline: none; border-color: var(--green); background: #fff; }\n.cm-search-clear {\n  position: absolute; right: 10px;\n  color: #9CA3AF; display: flex; align-items: center;\n}\n.cm-veg-filter {\n  display: flex; align-items: center; gap: 5px;\n  height: 40px; padding: 0 12px;\n  border-radius: 99px;\n  font-size: 12.5px; font-weight: 700;\n  border: 1.5px solid #E5E7EB;\n  color: #4B5563; background: var(--white);\n  transition: all .12s; flex-shrink: 0;\n}\n.cm-veg-filter.active { border-color: #16A34A; background: #F0FDF4; color: #166534; }\n.cm-veg-dot { width: 10px; height: 10px; border-radius: 2px; border: 1.5px solid #16A34A; position: relative; flex-shrink: 0; }\n.cm-veg-dot::after { content:''; position:absolute; inset:2px; border-radius:1px; background:#16A34A; }\n.cm-veg-filter:not(.active) .cm-veg-dot { border-color: #9CA3AF; }\n.cm-veg-filter:not(.active) .cm-veg-dot::after { background: #9CA3AF; }\n.cm-veg-text { display: none; }\n@media(min-width:360px){ .cm-veg-text { display: inline; } }\n\n/* ── Category tabs ───────────────────────────────────────── */\n.cm-cats {\n  display: flex; gap: 8px;\n  overflow-x: auto; overflow-y: hidden;\n  padding: 10px 14px;\n  background: var(--white);\n  border-bottom: 1px solid #EFEFEF;\n  scrollbar-width: none;\n  position: sticky; top: calc(52px + 62px); z-index: 30;\n}\n.cm-cats::-webkit-scrollbar { display: none; }\n.cm-cat-tab {\n  height: 34px; padding: 0 14px;\n  border-radius: 99px;\n  font-size: 13px; font-weight: 600;\n  color: #6B7280; background: #F3F4F6;\n  white-space: nowrap; flex-shrink: 0;\n  border: 1.5px solid transparent;\n  transition: all .15s; font-family: inherit;\n}\n.cm-cat-tab.active {\n  background: #E6F7F0;\n  color: #065F46;\n  border-color: var(--green);\n}\n\n/* ── Menu body ───────────────────────────────────────────── */\n.cm-menu-body { padding-bottom: 110px; }\n\n.cm-cat-section { margin-bottom: 8px; }\n.cm-cat-heading {\n  display: flex; align-items: center; gap: 8px;\n  padding: 14px 16px 10px;\n  background: var(--white);\n  font-size: 16px; font-weight: 800; color: #111;\n  letter-spacing: -.01em;\n  border-bottom: 1px solid #F3F4F6;\n  font-family: inherit;\n}\n.cm-cat-emoji { font-size: 18px; }\n.cm-cat-count {\n  margin-left: auto;\n  font-size: 11.5px; font-weight: 600;\n  color: #9CA3AF;\n  background: #F3F4F6;\n  padding: 2px 8px; border-radius: 99px;\n}\n\n/* Item row */\n.cm-item {\n  display: flex; gap: 0;\n  padding: 14px 16px;\n  background: var(--white);\n  border-bottom: 1px solid #F3F4F6;\n  transition: background .1s;\n}\n.cm-item:active { background: #FAFAFA; }\n\n/* veg/nonveg indicator */\n.cm-dot {\n  width: 14px; height: 14px;\n  border-radius: 3px; border: 1.5px solid;\n  display: flex; align-items: center; justify-content: center;\n  flex-shrink: 0; margin-top: 3px; margin-right: 10px;\n}\n.cm-dot-veg    { border-color: #16A34A; }\n.cm-dot-nonveg { border-color: #DC2626; }\n.cm-dot-inner  { width: 7px; height: 7px; border-radius: 50%; }\n.cm-dot-veg    .cm-dot-inner { background: #16A34A; }\n.cm-dot-nonveg .cm-dot-inner { background: #DC2626; }\n\n.cm-item-body { flex: 1; min-width: 0; }\n.cm-item-top  { display: flex; gap: 12px; }\n.cm-item-info { flex: 1; min-width: 0; }\n.cm-item-name-row {\n  display: flex; align-items: flex-start; gap: 6px;\n  flex-wrap: wrap; margin-bottom: 5px;\n}\n.cm-item-name {\n  font-size: 14.5px; font-weight: 700; color: #111;\n  line-height: 1.3; font-family: inherit;\n}\n.cm-badge {\n  display: inline-flex; align-items: center; gap: 3px;\n  font-size: 10px; font-weight: 700;\n  padding: 2px 7px; border-radius: 99px;\n  flex-shrink: 0;\n}\n.cm-badge-popular { background: #FEF3C7; color: #92400E; }\n.cm-badge-spicy   { background: #FEE2E2; color: #991B1B; font-size: 12px; padding: 1px 5px; }\n.cm-item-desc {\n  font-size: 12.5px; color: #6B7280; line-height: 1.5;\n  margin-bottom: 8px; font-family: inherit;\n}\n.cm-item-price { font-size: 15px; font-weight: 800; color: #111; }\n\n/* Item right col — image + add button */\n.cm-item-right { display: flex; flex-direction: column; align-items: center; gap: 8px; flex-shrink: 0; }\n.cm-item-img-wrap { position: relative; }\n.cm-item-img {\n  width: 80px; height: 80px; border-radius: 12px;\n  background: linear-gradient(135deg, #F3F4F6, #E5E7EB);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 32px;\n  border: 1px solid #F3F4F6;\n}\n.cm-like-btn {\n  position: absolute; top: 5px; right: 5px;\n  width: 22px; height: 22px; border-radius: 50%;\n  background: rgba(255,255,255,.9);\n  display: flex; align-items: center; justify-content: center;\n  box-shadow: 0 1px 4px rgba(0,0,0,.12);\n}\n\n/* Add / Qty buttons */\n.cm-add-btn {\n  display: inline-flex; align-items: center; gap: 4px;\n  height: 32px; padding: 0 14px;\n  border-radius: 8px;\n  font-size: 13px; font-weight: 700;\n  background: #fff; color: var(--green-dark);\n  border: 1.5px solid var(--green);\n  transition: background .1s;\n  font-family: inherit;\n}\n.cm-add-btn:active { background: var(--green-light); }\n\n.cm-qty {\n  display: flex; align-items: center; gap: 0;\n  height: 32px;\n  background: var(--green); border-radius: 8px;\n  overflow: hidden;\n}\n.cm-qty-btn {\n  width: 32px; height: 32px;\n  display: flex; align-items: center; justify-content: center;\n  color: #fff;\n  transition: background .1s;\n}\n.cm-qty-btn:active { background: rgba(255,255,255,.2); }\n.cm-qty-num {\n  min-width: 24px; text-align: center;\n  font-size: 14px; font-weight: 800; color: #fff;\n}\n\n/* Empty state */\n.cm-empty { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 56px 24px; }\n.cm-empty-icon { color: #D1D5DB; }\n.cm-empty p { font-size: 14px; color: #9CA3AF; font-family: inherit; }\n.cm-footer-note {\n  display: flex; align-items: center; justify-content: center; gap: 6px;\n  padding: 20px;\n  font-size: 12px; color: #9CA3AF;\n}\n\n/* ── Cart FAB ────────────────────────────────────────────── */\n.cm-cart-fab {\n  position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);\n  width: calc(100% - 28px); max-width: 452px;\n  height: 56px; border-radius: 16px;\n  background: #111; color: #fff;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 0 18px;\n  box-shadow: 0 8px 28px rgba(0,0,0,.24);\n  z-index: 50;\n  transition: transform .15s;\n}\n.cm-cart-fab:active { transform: translateX(-50%) scale(.98); }\n.cm-cart-fab-left { display: flex; align-items: center; gap: 10px; font-size: 14.5px; font-weight: 600; }\n.cm-cart-fab-count {\n  background: var(--green); color: #fff;\n  width: 24px; height: 24px; border-radius: 50%;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 12px; font-weight: 800;\n}\n.cm-cart-fab-right { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 700; }\n\n/* ── Bottom Sheet ────────────────────────────────────────── */\n.cm-backdrop {\n  position: fixed; inset: 0;\n  background: rgba(0,0,0,.5);\n  z-index: 70;\n  display: flex; align-items: flex-end; justify-content: center;\n}\n.cm-sheet {\n  background: #fff;\n  border-radius: 20px 20px 0 0;\n  width: 100%; max-width: 480px;\n  max-height: 80vh;\n  overflow-y: auto;\n  padding: 0 16px 24px;\n  animation: slideUp .25s ease;\n}\n.cm-sheet-tall { max-height: 92vh; }\n@keyframes slideUp {\n  from { transform: translateY(40px); opacity: 0; }\n  to   { transform: translateY(0);    opacity: 1; }\n}\n.cm-sheet-handle {\n  width: 36px; height: 4px; border-radius: 2px;\n  background: #E5E7EB; margin: 10px auto 16px;\n}\n.cm-sheet-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 0 0 14px; border-bottom: 1px solid #F3F4F6;\n  margin-bottom: 14px;\n}\n.cm-sheet-title { font-size: 17px; font-weight: 800; color: #111; font-family: inherit; }\n.cm-sheet-close {\n  width: 32px; height: 32px; border-radius: 50%;\n  background: #F3F4F6;\n  display: flex; align-items: center; justify-content: center;\n  color: #6B7280;\n}\n\n/* Cart */\n.cm-cart-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }\n.cm-cart-row { display: flex; align-items: center; gap: 10px; }\n.cm-cart-qty-ctrl {\n  display: flex; align-items: center; gap: 8px;\n  background: #F3F4F6; border-radius: 8px; padding: 5px 8px;\n}\n.cm-cart-qty-ctrl button { color: #374151; display: flex; align-items: center; }\n.cm-cart-qty-ctrl span { font-size: 14px; font-weight: 700; min-width: 16px; text-align: center; }\n.cm-cart-name { flex: 1; font-size: 14px; color: #111; font-family: inherit; font-weight: 500; }\n.cm-cart-price { font-size: 14px; font-weight: 700; color: #111; }\n.cm-cart-divider { height: 1px; background: #F3F4F6; margin: 10px 0; }\n.cm-cart-summary-row {\n  display: flex; justify-content: space-between;\n  font-size: 14px; color: #6B7280; margin-bottom: 14px;\n}\n.cm-cart-total-val { font-weight: 700; color: #111; }\n\n/* Checkout form */\n.cm-checkout-form { display: flex; flex-direction: column; gap: 14px; }\n.cm-field { display: flex; flex-direction: column; gap: 5px; }\n.cm-field label { font-size: 12.5px; font-weight: 700; color: #374151; font-family: inherit; }\n.cm-field input {\n  height: 46px; border: 1.5px solid #E5E7EB; border-radius: 12px;\n  padding: 0 14px; font-size: 15px; color: #111;\n  font-family: inherit; transition: border-color .15s;\n  background: #FAFAFA;\n}\n.cm-field input:focus { outline: none; border-color: var(--green); background: #fff; }\n\n.cm-type-row { display: flex; gap: 8px; }\n.cm-type-btn {\n  flex: 1; height: 46px; border-radius: 12px;\n  font-size: 14px; font-weight: 700;\n  border: 1.5px solid #E5E7EB; color: #4B5563; background: #fff;\n  transition: all .12s; font-family: inherit;\n}\n.cm-type-btn.active { border-color: var(--green); background: #E6F7F0; color: #065F46; }\n\n.cm-payment-section {}\n.cm-payment-label { font-size: 12.5px; font-weight: 700; color: #374151; margin-bottom: 8px; font-family: inherit; }\n.cm-pay-opts { display: flex; flex-direction: column; gap: 8px; }\n.cm-pay-opt {\n  display: flex; align-items: center; gap: 10px;\n  height: 50px; padding: 0 14px;\n  border-radius: 12px;\n  font-size: 14.5px; font-weight: 600;\n  border: 1.5px solid #E5E7EB; color: #374151; background: #fff;\n  transition: all .12s; font-family: inherit;\n}\n.cm-pay-opt.active { border-color: var(--green); background: #E6F7F0; color: #065F46; }\n.cm-pay-icon { font-size: 20px; }\n.cm-pay-check { margin-left: auto; color: var(--green); }\n\n.cm-order-summary {\n  background: #F8F8F8; border-radius: 12px; padding: 14px;\n  display: flex; flex-direction: column; gap: 7px;\n  border: 1px solid #F3F4F6;\n}\n.cm-sum-row { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: #374151; }\n.cm-sum-qty  { font-weight: 700; color: #9CA3AF; min-width: 22px; }\n.cm-sum-name { flex: 1; font-family: inherit; }\n.cm-sum-price { font-weight: 700; color: #111; }\n.cm-sum-total {\n  display: flex; justify-content: space-between;\n  font-size: 15px; font-weight: 800; color: #111;\n  border-top: 1px solid #E5E7EB; padding-top: 10px; margin-top: 4px;\n}\n\n.cm-proceed-btn {\n  height: 54px; border-radius: 14px;\n  font-size: 16px; font-weight: 800;\n  background: var(--green); color: #fff;\n  display: flex; align-items: center; justify-content: center; gap: 8px;\n  transition: background .12s, transform .1s;\n  font-family: inherit; width: 100%;\n}\n.cm-proceed-btn:active { transform: scale(.98); }\n\n/* ── Order Confirmed ─────────────────────────────────────── */\n.cm-confirmed-page {\n  min-height: 100vh; background: #F8F8F8;\n  display: flex; align-items: center; justify-content: center;\n  padding: 24px 16px; font-family: inherit;\n}\n.cm-confirmed-card {\n  background: #fff; border-radius: 24px; padding: 32px 24px;\n  width: 100%; max-width: 440px;\n  display: flex; flex-direction: column; align-items: center; gap: 16px;\n  box-shadow: 0 8px 32px rgba(0,0,0,.08);\n  text-align: center;\n}\n.cm-confirmed-pulse {\n  width: 76px; height: 76px; border-radius: 50%;\n  background: var(--green-light);\n  display: flex; align-items: center; justify-content: center;\n  font-size: 36px;\n  box-shadow: 0 0 0 12px rgba(29,158,117,.1);\n  animation: confPulse 2s ease infinite;\n}\n@keyframes confPulse {\n  0%,100% { box-shadow: 0 0 0 8px rgba(29,158,117,.1); }\n  50%      { box-shadow: 0 0 0 16px rgba(29,158,117,.05); }\n}\n.cm-confirmed-title { font-size: 24px; font-weight: 800; color: #111; font-family: inherit; }\n.cm-confirmed-sub { font-size: 14px; color: #6B7280; line-height: 1.6; font-family: inherit; }\n.cm-order-id-chip {\n  background: #F3F4F6; border-radius: 99px;\n  padding: 8px 20px; font-size: 13.5px; font-weight: 700; color: #374151;\n}\n\n.cm-status-current {\n  display: flex; align-items: center; gap: 8px;\n  background: var(--green-light); border-radius: 10px;\n  padding: 10px 16px; font-size: 14px; color: var(--green-darker);\n  width: 100%; justify-content: center;\n}\n.cm-status-dot-live {\n  width: 8px; height: 8px; border-radius: 50%; background: var(--green);\n  animation: ticker-pulse 2s infinite; flex-shrink: 0;\n}\n@keyframes ticker-pulse { 0%,100%{box-shadow:0 0 0 0 rgba(29,158,117,.5)} 70%{box-shadow:0 0 0 8px rgba(29,158,117,0)} }\n\n/* Progress track */\n.cm-track { display: flex; align-items: flex-start; gap: 0; width: 100%; justify-content: center; }\n.cm-track-step {\n  display: flex; flex-direction: column; align-items: center; gap: 6px;\n  flex: 1; position: relative;\n}\n.cm-track-dot {\n  width: 36px; height: 36px; border-radius: 50%;\n  background: #F3F4F6; color: #9CA3AF;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 16px;\n  border: 2px solid #E5E7EB;\n  transition: all .3s; z-index: 1;\n}\n.cm-track-step.done .cm-track-dot { background: var(--green-light); border-color: var(--green); }\n.cm-track-step.active .cm-track-dot { background: var(--green); border-color: var(--green); color: #fff; box-shadow: 0 0 0 6px rgba(29,158,117,.15); }\n.cm-track-label { font-size: 10.5px; color: #9CA3AF; text-align: center; font-family: inherit; }\n.cm-track-step.done .cm-track-label, .cm-track-step.active .cm-track-label { color: var(--green-darker); font-weight: 600; }\n.cm-track-line {\n  position: absolute; top: 17px; left: calc(50% + 18px);\n  width: calc(100% - 36px); height: 2px;\n  background: #E5E7EB; z-index: 0;\n}\n.cm-track-line.done { background: var(--green); }\n\n.cm-confirmed-items {\n  width: 100%;\n  background: #F8F8F8; border-radius: 12px; padding: 12px;\n  display: flex; flex-direction: column; gap: 6px;\n}\n.cm-conf-item-row {\n  display: flex; justify-content: space-between;\n  font-size: 13px; color: #374151; font-family: inherit;\n}\n\n.cm-confirmed-actions { display: flex; flex-direction: column; gap: 10px; width: 100%; }\n.cm-back-btn {\n  height: 46px; border-radius: 12px;\n  font-size: 14.5px; font-weight: 600;\n  background: #F3F4F6; color: #374151;\n  transition: background .12s; font-family: inherit;\n}\n.cm-back-btn:active { background: #E5E7EB; }\n\n/* ── Full-screen mobile styles ───────────────────────────── */\n@media (max-width: 480px) {\n  .cm-page { max-width: 100%; }\n  .cm-cart-fab { width: calc(100% - 24px); max-width: 100%; }\n  .cm-sheet { max-width: 100%; border-radius: 20px 20px 0 0; }\n  .cm-lang-dropdown { right: -40px; }\n}\n\n/* ── Customer Login / Profile / App Download ──────────────── */\n.cm-login-sheet { display:flex; flex-direction:column; gap:16px; padding-bottom:8px; }\n.cm-login-title { font-size:18px; font-weight:800; color:#111; }\n.cm-login-sub { font-size:13.5px; color:#6B7280; margin-top:-8px; }\n.cm-login-field label { font-size:12px; font-weight:700; color:#374151; display:block; margin-bottom:5px; }\n.cm-login-field input { width:100%; height:46px; border:1.5px solid #E5E7EB; border-radius:12px; padding:0 14px; font-size:15px; }\n.cm-login-field input:focus { outline:none; border-color:var(--green); }\n.cm-login-benefits { display:flex; flex-direction:column; gap:8px; background:#F8F8F8; border-radius:12px; padding:12px 14px; }\n.cm-login-benefit { display:flex; align-items:center; gap:8px; font-size:13px; color:#374151; }\n.cm-app-banner { background:linear-gradient(135deg,#111,#333); border-radius:16px; padding:20px; display:flex; flex-direction:column; gap:14px; margin:0 14px; }\n.cm-app-title { font-size:17px; font-weight:800; color:#fff; }\n.cm-app-sub { font-size:13px; color:rgba(255,255,255,.65); margin-top:-8px; line-height:1.5; }\n.cm-app-btns { display:flex; gap:10px; }\n.cm-app-btn { flex:1; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; gap:7px; font-size:13.5px; font-weight:700; }\n.cm-app-btn-android { background:var(--green); color:#fff; }\n.cm-app-btn-ios     { background:rgba(255,255,255,.15); color:#fff; border:1px solid rgba(255,255,255,.25); }\n.cm-profile-section { background:var(--white); margin-bottom:8px; }\n.cm-profile-header { display:flex; align-items:center; gap:14px; padding:16px; }\n.cm-profile-avatar { width:52px; height:52px; border-radius:50%; background:var(--green); color:#fff; font-size:20px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n.cm-profile-name { font-size:17px; font-weight:800; color:#111; }\n.cm-profile-phone { font-size:13px; color:#6B7280; }\n.cm-profile-actions { display:flex; gap:8px; padding:0 16px 16px; }\n.cm-profile-action { flex:1; height:38px; border-radius:10px; font-size:13px; font-weight:600; border:1.5px solid #E5E7EB; color:#374151; background:var(--white); }\n.cm-order-hist-item { display:flex; flex-direction:column; gap:6px; padding:14px 16px; border-bottom:1px solid #F3F4F6; }\n.cm-hist-header { display:flex; align-items:center; justify-content:space-between; }\n.cm-hist-id { font-size:13px; font-weight:700; color:#111; }\n.cm-hist-date { font-size:11.5px; color:#9CA3AF; }\n.cm-hist-items { font-size:13px; color:#6B7280; }\n.cm-hist-footer { display:flex; align-items:center; justify-content:space-between; }\n.cm-hist-total { font-size:14px; font-weight:800; color:#111; }\n.cm-hist-status { font-size:11px; font-weight:700; padding:3px 9px; border-radius:99px; background:var(--green-light); color:var(--green-darker); }\n.cm-hist-reorder { height:30px; padding:0 14px; border-radius:8px; font-size:12px; font-weight:700; background:#111; color:#fff; }\n.cm-wallet-card { background:linear-gradient(135deg,var(--green-dark),var(--green)); border-radius:16px; padding:20px; color:#fff; margin:0 14px; }\n.cm-wallet-label { font-size:12px; opacity:.7; margin-bottom:4px; }\n.cm-wallet-balance { font-size:36px; font-weight:800; letter-spacing:-.02em; }\n.cm-wallet-sub { font-size:12px; opacity:.65; margin-top:4px; }\n.cm-wallet-actions { display:flex; gap:10px; margin-top:14px; }\n.cm-wallet-btn { flex:1; height:38px; border-radius:10px; font-size:13px; font-weight:700; background:rgba(255,255,255,.15); color:#fff; border:1px solid rgba(255,255,255,.25); }\n"],["STYLE",{},".onb-page { min-height:100vh; background:var(--gray-50); display:flex; flex-direction:column; }\n.onb-topbar { display:flex; align-items:center; justify-content:space-between; padding:16px 24px; background:var(--white); border-bottom:1px solid var(--gray-100); }\n.onb-brand { display:flex; align-items:center; gap:8px; font-size:18px; font-weight:800; color:var(--gray-900); }\n.onb-brand em { font-style:normal; color:var(--green); }\n.onb-skip { font-size:13px; color:var(--gray-400); font-weight:500; }\n.onb-progress-bar { height:3px; background:var(--gray-100); }\n.onb-progress-fill { height:100%; background:var(--green); transition:width .4s ease; }\n.onb-dots { display:flex; gap:8px; justify-content:center; padding:16px 0 0; }\n.onb-dot { width:8px; height:8px; border-radius:50%; background:var(--gray-200); transition:all .2s; }\n.onb-dot.active { background:var(--green); width:24px; border-radius:4px; }\n.onb-dot.done { background:var(--green); opacity:.5; }\n.onb-body { flex:1; display:flex; align-items:center; justify-content:center; padding:24px 16px; }\n.onb-card { background:var(--white); border:1px solid var(--gray-200); border-radius:var(--radius-xl); padding:36px 32px; width:100%; max-width:520px; box-shadow:var(--shadow-lg); }\n.onb-step { display:flex; flex-direction:column; gap:20px; }\n.onb-welcome-icon { font-size:52px; text-align:center; }\n.onb-title { font-size:24px; font-weight:800; color:var(--gray-900); letter-spacing:-.02em; }\n.onb-sub { font-size:14px; color:var(--gray-500); line-height:1.6; margin-top:-12px; }\n.onb-lang-label { font-size:12px; font-weight:600; color:var(--gray-500); margin-bottom:8px; }\n.onb-lang-grid { display:flex; flex-wrap:wrap; gap:7px; }\n.onb-lang-chip { height:32px; padding:0 12px; border-radius:99px; font-size:12.5px; font-weight:600; border:1.5px solid var(--gray-200); color:var(--gray-600); background:var(--white); transition:all .12s; }\n.onb-lang-chip.active { border-color:var(--green); background:var(--green-light); color:var(--green-darker); }\n.onb-feature-list { display:flex; flex-direction:column; gap:10px; background:var(--gray-50); border-radius:var(--radius-md); padding:16px; }\n.onb-feature-item { display:flex; align-items:center; gap:10px; font-size:14px; color:var(--gray-700); }\n.onb-form { display:flex; flex-direction:column; gap:14px; }\n.onb-field { display:flex; flex-direction:column; gap:5px; }\n.onb-field label { font-size:12.5px; font-weight:600; color:var(--gray-700); }\n.onb-field input { height:44px; border:1.5px solid var(--gray-200); border-radius:var(--radius-md); padding:0 14px; font-size:14px; color:var(--gray-900); transition:border-color .15s; }\n.onb-field input:focus { outline:none; border-color:var(--green); }\n.onb-logo-upload { display:flex; align-items:center; gap:14px; }\n.onb-logo-preview { width:52px; height:52px; border-radius:12px; background:var(--green-light); color:var(--green-darker); font-size:22px; font-weight:800; display:flex; align-items:center; justify-content:center; }\n.onb-logo-label { font-size:12.5px; font-weight:600; color:var(--gray-700); margin-bottom:6px; }\n.onb-upload-btn { display:inline-flex; align-items:center; gap:6px; height:32px; padding:0 14px; border-radius:8px; font-size:12.5px; font-weight:600; background:var(--gray-100); color:var(--gray-700); cursor:pointer; }\n.onb-menu-opts { display:flex; flex-direction:column; gap:10px; }\n.onb-menu-opt { display:flex; align-items:center; gap:14px; padding:16px; border:1.5px solid var(--gray-200); border-radius:var(--radius-md); text-align:left; cursor:pointer; transition:all .12s; background:var(--white); }\n.onb-menu-opt:hover { border-color:var(--green); }\n.onb-menu-opt.active { border-color:var(--green); background:var(--green-light); }\n.onb-menu-icon { font-size:24px; flex-shrink:0; }\n.onb-menu-title { font-size:14px; font-weight:700; color:var(--gray-900); }\n.onb-menu-desc { font-size:12.5px; color:var(--gray-500); margin-top:2px; }\n.onb-menu-check { color:var(--green); margin-left:auto; flex-shrink:0; }\n.onb-services-grid { display:flex; flex-wrap:wrap; gap:10px; }\n.onb-service-chip { display:flex; align-items:center; gap:7px; height:42px; padding:0 16px; border-radius:99px; font-size:13.5px; font-weight:600; border:1.5px solid var(--gray-200); color:var(--gray-700); background:var(--white); transition:all .12s; }\n.onb-service-chip.active { border-color:var(--green); background:var(--green-light); color:var(--green-darker); }\n.onb-step-success { align-items:center; }\n.onb-qr-ready { display:flex; flex-direction:column; align-items:center; gap:16px; text-align:center; }\n.onb-qr-icon { width:88px; height:88px; border-radius:24px; background:var(--green-light); display:flex; align-items:center; justify-content:center; }\n.onb-qr-url { font-size:13px; font-family:monospace; background:var(--gray-100); padding:8px 16px; border-radius:8px; color:var(--gray-700); }\n.onb-qr-actions { display:flex; gap:10px; }\n.onb-dl-btn { height:38px; padding:0 16px; border-radius:var(--radius-md); font-size:13px; font-weight:600; border:1.5px solid var(--gray-200); color:var(--gray-700); background:var(--white); }\n.onb-nav { display:flex; gap:10px; justify-content:flex-end; margin-top:8px; padding-top:20px; border-top:1px solid var(--gray-100); }\n.onb-back-btn { height:44px; padding:0 20px; border-radius:var(--radius-md); font-size:14px; font-weight:500; color:var(--gray-600); background:var(--gray-100); }\n.onb-next-btn { height:44px; padding:0 24px; border-radius:var(--radius-md); font-size:14px; font-weight:700; background:var(--green); color:var(--white); display:flex; align-items:center; gap:8px; }\n"],["STYLE",{},".legal-page { min-height: 100vh; background: #fff; font-family: 'Inter', Arial, sans-serif; }\n.legal-topbar { display: flex; align-items: center; justify-content: space-between; padding: 16px 32px; border-bottom: 1px solid #E5E7EB; position: sticky; top: 0; background: #fff; z-index: 10; }\n.legal-logo { font-size: 18px; cursor: pointer; color: #111827; }\n.legal-logo strong { color: #1D9E75; }\n.legal-back { background: none; border: 1px solid #E5E7EB; padding: 6px 14px; border-radius: 8px; cursor: pointer; font-size: 13px; font-weight: 600; color: #374151; }\n.legal-back:hover { background: #F9FAFB; }\n.legal-content { max-width: 760px; margin: 0 auto; padding: 48px 32px; }\n.legal-content h1 { font-size: 32px; font-weight: 800; color: #111827; margin-bottom: 8px; }\n.legal-content h2 { font-size: 18px; font-weight: 700; color: #1D9E75; margin: 28px 0 10px; }\n.legal-content p { font-size: 15px; line-height: 1.8; color: #374151; margin-bottom: 12px; }\n.legal-content a { color: #1D9E75; text-decoration: none; font-weight: 600; }\n.legal-content a:hover { text-decoration: underline; }\n.legal-meta { font-size: 13px; color: #9CA3AF; margin-bottom: 32px; border-bottom: 1px solid #F3F4F6; padding-bottom: 20px; }\n.legal-updated { font-size: 12px; color: #9CA3AF; margin-top: 40px; padding-top: 20px; border-top: 1px solid #F3F4F6; }\n@media (max-width: 640px) { .legal-content { padding: 24px 16px; } .legal-topbar { padding: 12px 16px; } }\n"],["STYLE",{},".ai-hub { display:flex; height:calc(100vh - var(--topbar-h,64px)); overflow:hidden; }\n.ai-sidebar { width:260px; flex-shrink:0; background:var(--white); border-right:1px solid var(--gray-200); overflow-y:auto; display:flex; flex-direction:column; }\n.ai-sidebar-header { display:flex; align-items:center; gap:8px; padding:16px; border-bottom:1px solid var(--gray-100); font-size:14px; font-weight:700; color:var(--gray-900); }\n.ai-badge { margin-left:auto; font-size:11px; background:var(--green-light); color:var(--green-dark); padding:2px 8px; border-radius:999px; font-weight:600; }\n.ai-nav-item { width:100%; display:flex; align-items:flex-start; gap:10px; padding:10px 16px; border:none; background:none; cursor:pointer; text-align:left; color:var(--gray-600); transition:background .12s; border-left:2px solid transparent; }\n.ai-nav-item:hover { background:var(--gray-50); }\n.ai-nav-item.active { background:var(--green-light); border-left-color:var(--green); color:var(--green-dark); }\n.ai-nav-text { flex:1; }\n.ai-nav-label { display:block; font-size:13px; font-weight:600; }\n.ai-nav-desc { display:block; font-size:11px; color:var(--gray-400); margin-top:1px; }\n.ai-nav-arrow { color:var(--gray-300); flex-shrink:0; margin-top:2px; }\n.ai-nav-item.active .ai-nav-arrow { color:var(--green); }\n.ai-panel { flex:1; overflow-y:auto; padding:24px; background:var(--gray-50); }\n@media (max-width:768px) { .ai-sidebar { display:none; } }\n"],["STYLE",{},"/* ─── AviQR design tokens ─────────────────────────────────────────────────── */\n:root {\n  /* Brand */\n  --green: #1D9E75;\n  --green-dark: #0F6E56;\n  --green-darker: #085041;\n  --green-light: #E1F5EE;\n  --green-mid: #5DCAA5;\n\n  /* Neutrals */\n  --black: #0A0A0A;\n  --gray-900: #111111;\n  --gray-800: #1A1A1A;\n  --gray-700: #2D2D2D;\n  --gray-600: #4A4A4A;\n  --gray-500: #6B7280;\n  --gray-400: #9CA3AF;\n  --gray-300: #D1D5DB;\n  --gray-200: #E5E7EB;\n  --gray-100: #F3F4F6;\n  --gray-50: #FAFAFA;\n  --white: #FFFFFF;\n\n  /* Accent / semantic */\n  --amber: #D97706;\n  --amber-bg: #FEF3C7;\n  --red: #DC2626;\n  --red-bg: #FEE2E2;\n  --blue: #2563EB;\n  --blue-bg: #DBEAFE;\n  --purple: #7C3AED;\n  --purple-bg: #EDE9FE;\n\n  /* Layout */\n  --sidebar-w: 240px;\n  --topbar-h: 64px;\n  --radius-sm: 8px;\n  --radius-md: 12px;\n  --radius-lg: 16px;\n  --radius-xl: 20px;\n  --radius-pill: 999px;\n\n  /* Shadows */\n  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);\n  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);\n  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.08);\n  --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);\n\n  /* Typography */\n  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;\n}\n\n/* ─── Reset & base ────────────────────────────────────────────────────────── */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nhtml { font-size: 16px; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }\nbody { font-family: var(--font-sans); color: var(--gray-900); background: var(--gray-50); line-height: 1.5; }\nimg { max-width: 100%; display: block; }\nbutton { font-family: inherit; cursor: pointer; border: none; background: none; }\na { color: inherit; text-decoration: none; }\ninput, select, textarea { font-family: inherit; }\n\n/* Scrollbar */\n::-webkit-scrollbar { width: 8px; height: 8px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: var(--gray-300); border-radius: 4px; }\n::-webkit-scrollbar-thumb:hover { background: var(--gray-400); }\n\n/* Focus states */\nbutton:focus-visible, input:focus-visible, select:focus-visible, a:focus-visible {\n  outline: 2px solid var(--green);\n  outline-offset: 2px;\n}\n\n/* ─── Utility classes ─────────────────────────────────────────────────────── */\n.sr-only {\n  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n  overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;\n}\n\n/* ─── Page wrapper ────────────────────────────────────────────────────────── */\n.page-content {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  padding: 0;\n}\n\n/* ─── Form fields ─────────────────────────────────────────────────────────── */\n.field { display: flex; flex-direction: column; gap: 5px; }\n\n.field-label {\n  font-size: 12.5px;\n  font-weight: 600;\n  color: var(--gray-700);\n}\n\n.field-input {\n  height: 40px;\n  border: 1.5px solid var(--gray-200);\n  border-radius: 8px;\n  padding: 0 12px;\n  font-size: 14px;\n  font-family: var(--font-sans);\n  color: var(--gray-900);\n  background: var(--white);\n  transition: border-color .15s;\n  outline: none;\n  width: 100%;\n}\n.field-input:focus { border-color: var(--green); }\n.field-input::placeholder { color: var(--gray-400); }\ntextarea.field-input { height: auto; padding: 10px 12px; resize: vertical; }\n\n/* ─── Demo notice ─────────────────────────────────────────────────────────── */\n.demo-notice {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  background: #FEF3C7;\n  border: 1px solid #FCD34D;\n  border-radius: 8px;\n  padding: 10px 16px;\n  font-size: 13px;\n  color: #92400E;\n}\n.demo-notice a,\n.demo-notice button { color: #92400E; font-weight: 700; background: none; border: none; cursor: pointer; padding: 0; }\n\n/* ─── Text utilities ──────────────────────────────────────────────────────── */\n.text-clamp {\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n/* ─── Menu tag chips ──────────────────────────────────────────────────────── */\n.menu-tag { font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 999px; }\n.tag-bestseller { background: #FEF3C7; color: #92400E; }\n.tag-spicy      { background: #FEE2E2; color: #991B1B; }\n.tag-veg        { background: #D1FAE5; color: #065F46; }\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"auth-page"},["DIV",{"class":"auth-left"},["DIV",{"class":"auth-brand"},["DIV",{"class":"auth-brand-logo"},["DIV",{"style":"width: 36px; height: 36px;"},["svg",{"viewBox":"0 0 28 28","fill":"none"},["rect",{"x":"3","y":"3","width":"9","height":"9","rx":"2","fill":"#1D9E75"}],["rect",{"x":"16","y":"3","width":"9","height":"9","rx":"2","fill":"#fff","opacity":".92"}],["rect",{"x":"3","y":"16","width":"9","height":"9","rx":"2","fill":"#fff","opacity":".92"}],["rect",{"x":"5.5","y":"5.5","width":"4","height":"4","rx":"1","fill":"#111"}],["rect",{"x":"18.5","y":"5.5","width":"4","height":"4","rx":"1","fill":"#111"}],["rect",{"x":"5.5","y":"18.5","width":"4","height":"4","rx":"1","fill":"#111"}],["rect",{"x":"16","y":"16","width":"4","height":"4","rx":"1","fill":"#1D9E75"}],["rect",{"x":"21","y":"16","width":"4","height":"4","rx":"1","fill":"#1D9E75"}],["rect",{"x":"16","y":"21","width":"4","height":"4","rx":"1","fill":"#1D9E75"}],["rect",{"x":"21","y":"21","width":"4","height":"4","rx":"1","fill":"#5DCAA5"}]]],["SPAN",{"class":"auth-brand-name"},"Avi",["EM",{},"QR"]]]],["DIV",{"class":"auth-left-body"},["H2",{"class":"auth-left-title"},"Run your restaurant from a single QR."],["P",{"class":"auth-left-sub"},"Orders, menus, payments, staff and reports — one platform for restaurants, hotels and malls across India."],["DIV",{"class":"auth-left-badges"},["SPAN",{"class":"auth-badge"},"🍽️ Live order tracking"],["SPAN",{"class":"auth-badge"},"🌐 9 Indian languages"],["SPAN",{"class":"auth-badge"},"⚡ Dynamic pricing"],["SPAN",{"class":"auth-badge"},"📊 Revenue analytics"],["SPAN",{"class":"auth-badge"},"🏨 Hotel room service"],["SPAN",{"class":"auth-badge"},"🏬 Mall food courts"]]],["P",{"style":"font-size: 12px; color: var(--gray-600); margin-top: auto;"},"New here? ",["A",{"href":"/register","st