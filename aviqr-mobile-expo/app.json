{
  "expo": {
    "name": "AviQR",
    "slug": "aviqr",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "aviqr",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.aviqr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes to order from restaurants",
        "NSPhotoLibraryUsageDescription": "Upload menu images for OCR scanning"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "package": "in.aviqr.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Allow AviQR to access your camera to scan QR codes." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
