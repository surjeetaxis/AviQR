{
  "expo": {
    "name": "AviQR",
    "slug": "aviqr",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "aviqr",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.aviqr.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AviQR uses your camera to scan QR codes and upload menu images for text recognition.",
        "NSPhotoLibraryUsageDescription": "AviQR accesses your photo library to upload menu images for automatic menu creation.",
        "NSUserNotificationsUsageDescription": "AviQR sends notifications for new orders, order status updates, and low-stock alerts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "package": "in.aviqr.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AviQR to access your camera to scan QR codes and capture menu images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.aviqr.in",
      "privacyPolicyUrl": "https://aviqr.in/privacy",
      "termsUrl": "https://aviqr.in/terms",
      "supportEmail": "support@aviqr.in",
      "sentryDsn": "",
      "sentryNote": "Set sentryDsn to your Sentry DSN from sentry.io project settings"
    }
  }
}